#!/usr/bin/env bash
# Invoke the bounded Event Plane inspection/administration client.
set -euo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
command -v python3 >/dev/null 2>&1 || {
  printf '{"ok":false,"error":{"code":"unavailable","message":"python3 is unavailable"}}\n'
  exit 69
}
exec python3 "$(dirname "$self")/lib/event_plane_client.py" "$@"
