#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
cd "$root"

: "${HOME:?qq: HOME is required}"
state_root=${XDG_STATE_HOME:-"$HOME/.local/state"}
export DSH_HOME=${QQ_DSH_HOME:-${DSH_HOME:-"$state_root/qq"}}
export DSH_TELEMETRY_DISABLED=${DSH_TELEMETRY_DISABLED:-1}
export QQ_PORT=${QQ_PORT:-3082}
export QQ_DSH_PROVIDER=${QQ_DSH_PROVIDER:-qwen-token-plan}
export QQ_DSH_MODEL=${QQ_DSH_MODEL:-deepseek-v4-pro-0813}

mkdir -p -- "$DSH_HOME"
chmod 700 "$DSH_HOME"

has_qwen_credential_file() {
  local file=$1
  local kind=$2
  [[ -f $file ]] || return 1
  if [[ $kind == yaml ]]; then
    grep -Eq '^[[:space:]]*QWEN_TOKEN_PLAN_API_KEY[[:space:]]*:[[:space:]]*[^[:space:]]' "$file"
  else
    grep -Eq '^[[:space:]]*(export[[:space:]]+)?QWEN_TOKEN_PLAN_API_KEY[[:space:]]*=' "$file"
  fi
}

auth_ext=json
selected_login=""
case $QQ_DSH_PROVIDER in
  qwen-token-plan)
    if [[ -z ${QWEN_TOKEN_PLAN_API_KEY:-} ]] &&
      ! has_qwen_credential_file "$DSH_HOME/.credentials.yaml" yaml &&
      ! has_qwen_credential_file "$root/.env" env &&
      ! has_qwen_credential_file "$DSH_HOME/.env" env; then
      cat >&2 <<EOF
qq: qwen-token-plan requires QWEN_TOKEN_PLAN_API_KEY.
Export it before starting, or store it under that name in:
  $DSH_HOME/.credentials.yaml  (chmod 600)

The launcher uses DSH's public credential-reference seam. It does not read
or copy Pi credentials.
EOF
      exit 2
    fi
    ;;
  xai-auth)
    selected_login="$DSH_HOME/.qq-grok-auth.${auth_ext}"
    if [[ ! -f $selected_login ]]; then
      printf 'qq: xai-auth requires a Grok login on this host (qq-login grok).\n' >&2
      exit 2
    fi
    ;;
  openai-codex)
    selected_login="$DSH_HOME/.qq-codex-auth.${auth_ext}"
    if [[ ! -f $selected_login ]]; then
      printf 'qq: openai-codex requires a Codex login on this host (qq-login codex).\n' >&2
      exit 2
    fi
    ;;
esac

toolchain="$root/dsh"
dsh="$toolchain/node_modules/.bin/dsh"
if [[ ! -x $dsh ]]; then
  printf 'qq: installing pinned DSH toolchain\n' >&2
  npm ci --prefix "$toolchain" --no-audit --no-fund
fi

# Present siblings. qq is always the session plugin. Every other $root/qq-*
# package is added when its package.json exists; HAVE flags from the same scan
# keep today's host.patch.yml inserts disabled when a named sibling is absent.
export QQ_DSH_HAVE_UI=0 QQ_DSH_HAVE_RELAY=0 QQ_DSH_HAVE_WORKFLOWS=0
qq_siblings=()
for qq_pkg in "$root"/qq-*/package.json; do
  [[ -f $qq_pkg ]] || continue
  qq_dir=${qq_pkg%/package.json}
  qq_siblings+=("$qq_dir")
  case ${qq_dir##*/} in
    qq-ui) QQ_DSH_HAVE_UI=1 ;;
    qq-relay) QQ_DSH_HAVE_RELAY=1 ;;
    qq-workflows) QQ_DSH_HAVE_WORKFLOWS=1 ;;
  esac
done

# image-finder lives next to this repo, not as qq-*. Bind it the same way as
# qq-tasks: dsh plugin add from the sibling tree, not host.patch.yml.
find_root=${QQ_FIND_ROOT:-"$root/../image-finder"}
if [[ -f $find_root/package.json ]] && grep -Fq '"name": "@hypermemetic-ai/image-finder"' "$find_root/package.json"; then
  qq_siblings+=("$(cd -- "$find_root" && pwd -P)")
fi

# media-box lives next to this repo, not as qq-*. Bind like image-finder.
# Missing tree must not stop qq. Not named in host.patch.yml.
media_root=${QQ_MEDIA_ROOT:-"$root/../media-box"}
if [[ -f $media_root/package.json ]] && grep -Fq '"name": "@hypermemetic-ai/media-box"' "$media_root/package.json"; then
  qq_siblings+=("$(cd -- "$media_root" && pwd -P)")
fi

profile_manifest="$DSH_HOME/profiles/qq/package.json"
if ! node - "$profile_manifest" "$root/qq" ${qq_siblings[@]+"${qq_siblings[@]}"} <<'NODE'
const { existsSync, readFileSync } = require("node:fs");
const { join } = require("node:path");
const [manifestPath, qqPath, ...siblingPaths] = process.argv.slice(2);
const packages = [["@hypermemetic-ai/qq", qqPath]];
for (const siblingPath of siblingPaths) {
  const pkg = JSON.parse(readFileSync(join(siblingPath, "package.json"), "utf8"));
  packages.push([pkg.name, siblingPath]);
}
try {
  const manifest = require(manifestPath);
  const deps = manifest.dependencies ?? {};
  const linked = (name, path) => deps[name] === `link:${path}` || deps[name] === `file:${path}`;
  for (const [name, path] of packages) {
    if (existsSync(join(path, "package.json")) && !linked(name, path)) process.exit(1);
  }
  process.exit(0);
} catch {
  process.exit(1);
}
NODE
then
  printf 'qq: preparing persistent DSH profile\n' >&2
  "$dsh" plugin --profile qq add "$root/qq"
  for sibling in ${qq_siblings[@]+"${qq_siblings[@]}"}; do
    "$dsh" plugin --profile qq add "$sibling"
  done
else
  :
fi

session_file="$DSH_HOME/qq.session"
if [[ -n ${QQ_DSH_SESSION_ID:-} ]]; then
  session_id=$QQ_DSH_SESSION_ID
elif [[ -f $session_file ]]; then
  session_id=$(<"$session_file")
else
  session_id="session-$(node -e 'console.log(crypto.randomUUID())')"
fi
if [[ ! $session_id =~ ^session-[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$ ]]; then
  printf 'qq: invalid session id in QQ_DSH_SESSION_ID or %s\n' "$session_file" >&2
  exit 2
fi
if [[ ! -f $session_file ]]; then
  umask 077
  printf '%s\n' "$session_id" >"$session_file"
fi
export QQ_DSH_SESSION_ID=$session_id

printf 'qq: %s/%s · %s\n' "$QQ_DSH_PROVIDER" "$QQ_DSH_MODEL" "$QQ_DSH_SESSION_ID" >&2
printf 'qq: state %s · http://127.0.0.1:%s/qq\n' "$DSH_HOME" "$QQ_PORT" >&2
exec node --import "$toolchain/qq-dsh-model-compat.mjs" "$dsh" --profile qq --patch "$root/qq/host.patch.yml" "$@"