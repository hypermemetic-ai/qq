#!/usr/bin/env bash
# Materialize the single-home Task store into a derived scratch tree and render it.
# shellcheck disable=SC1091,SC2016
set -euo pipefail
export LC_ALL=C

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
# shellcheck source=bin/lib/qq-bin.sh
source "$(dirname "$self")/lib/qq-bin.sh"
# shellcheck source=bin/lib/qq-engine.sh
source "$(dirname "$self")/lib/qq-engine.sh"
qq_engine_init qq-board board

usage() {
  cat <<'EOF'
usage: qq-board [inspect] reconcile [--repo <path>] [--dry-run]
       qq-board watch [--repo <path>] [--interval <seconds>]

reconcile materializes the store's Task records into a derived scratch tree
outside every checkout and renders that single-home view without aggregation.
inspect and --dry-run report the same result without changing the scratch tree.
Source records are never written.

The Herdr board pane command is:
  qq-board watch --interval 3

watch rematerializes the scratch tree before each vendor board render.
EOF
}

mode=apply
if [ "${1:-}" = inspect ]; then mode=inspect; shift; fi
case "${1:-}" in
  -h | --help | help) usage; exit 0 ;;
  reconcile | watch) verb="$1"; shift ;;
  *) qq_engine_error 'usage: qq-board [inspect] reconcile [--repo <path>] [--dry-run] | qq-board watch [--repo <path>] [--interval <seconds>]' ;;
esac
repo=.; interval=3; interval_supplied=false; dry_run=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo) [ "$#" -ge 2 ] || qq_engine_error '--repo requires a path'; repo="$2"; shift 2 ;;
    --interval) [ "$#" -ge 2 ] || qq_engine_error '--interval requires seconds'; interval="$2"; interval_supplied=true; shift 2 ;;
    --dry-run) dry_run=true; shift ;;
    -h | --help) usage; exit 0 ;;
    *) qq_engine_error "unknown qq-board argument: $1" ;;
  esac
done
qq_engine_set_action "$mode:$verb"
if [ "$verb" = reconcile ]; then
  [ "$interval_supplied" = false ] || qq_engine_error '--interval applies only to watch'
else
  [ "$mode" = apply ] || qq_engine_error 'inspect applies only to reconcile'
  [ "$dry_run" = false ] || qq_engine_error '--dry-run applies only to reconcile'
  [[ "$interval" =~ ^[1-9][0-9]*$ ]] || qq_engine_error '--interval must be a positive integer number of seconds'
fi

qq_resolve_bin git || qq_engine_error "$QQ_BIN_ERROR"; git_bin="$QQ_BIN_RESULT"
checkout_root="$({ "$git_bin" -C "$repo" rev-parse --show-toplevel 2>/dev/null || true; })"
[ -n "$checkout_root" ] || qq_engine_error "not a Git checkout: $repo"
checkout_root="$(cd "$checkout_root" && pwd -P)" || qq_engine_error "cannot canonicalize Repository root: $checkout_root"
worktrees="$({ "$git_bin" -C "$checkout_root" worktree list --porcelain 2>/dev/null; })" \
  || qq_engine_error "cannot list Git worktrees for: $checkout_root"
[ -n "$worktrees" ] || qq_engine_error "Git returned an empty worktree list for: $checkout_root"
listed_worktrees=(); main_paths=(); current_worktree=
while IFS= read -r line; do
  case "$line" in
    'worktree '*) current_worktree="${line#worktree }"; listed_worktrees+=("$current_worktree") ;;
    'branch refs/heads/main') [ -n "$current_worktree" ] && main_paths+=("$current_worktree") ;;
  esac
done <<<"$worktrees"
if [ "${#main_paths[@]}" -ne 1 ]; then
  state="$("$QQ_ENGINE_JQ" -cn --arg checkout_root "$checkout_root" --argjson count "${#main_paths[@]}" \
    '{checkout_root:$checkout_root,primary_main_count:$count}')"
  qq_engine_error 'Expected exactly one primary checkout attached to refs/heads/main.' "$state"
fi
repo_root="$(cd "${main_paths[0]}" 2>/dev/null && pwd -P)" || qq_engine_error 'The primary main checkout is unavailable.'
worktree_paths=()
for path in "${listed_worktrees[@]}"; do
  path="$(cd "$path" 2>/dev/null && pwd -P)" || qq_engine_error 'A listed Git worktree is unavailable.'
  worktree_paths+=("$path")
done

primary_tasks_dir="$repo_root/backlog/tasks"; primary_config="$repo_root/backlog/config.yml"
[ -d "$primary_tasks_dir" ] || qq_engine_error "Task records directory is missing: $primary_tasks_dir"
[ -f "$primary_config" ] || qq_engine_error "Backlog config is missing: $primary_config"
qq_resolve_bin python3 || qq_engine_error "$QQ_BIN_ERROR"; python_bin="$QQ_BIN_RESULT"
identity_helper="$(dirname "$self")/lib/qq_task_identity.py"
[ -f "$identity_helper" ] || qq_engine_error "Task identity helper is missing: $identity_helper"
qq_resolve_bin sha256sum || qq_engine_error "$QQ_BIN_ERROR"; sha256sum_bin="$QQ_BIN_RESULT"
qq_resolve_bin find || qq_engine_error "$QQ_BIN_ERROR"; find_bin="$QQ_BIN_RESULT"
repo_key="$(printf %s "$repo_root" | "$sha256sum_bin" | awk '{print $1}')"
[[ "$repo_key" =~ ^[0-9a-f]{64}$ ]] || qq_engine_error 'Could not derive the Repository scratch-board key.'
cache_home="${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}"
[ -n "$cache_home" ] || qq_engine_error 'HOME or XDG_CACHE_HOME is required for the scratch board.'
[[ "$cache_home" = /* ]] || qq_engine_error 'The scratch-board cache root must be an absolute path.'
cache_home="$(readlink -m -- "$cache_home")" || qq_engine_error 'cannot canonicalize scratch-board cache root'
board_parent="$(readlink -m -- "$cache_home/qq/board")" || qq_engine_error 'cannot canonicalize scratch-board parent'
scratch_root="$board_parent/$repo_key"
for path in "${worktree_paths[@]}"; do
  case "$scratch_root" in "$path" | "$path"/*)
    state="$("$QQ_ENGINE_JQ" -cn --arg scratch_root "$scratch_root" --arg worktree "$path" '{scratch_root:$scratch_root,worktree:$worktree}')"
    qq_engine_error 'The scratch board must be outside every Repository checkout.' "$state" ;;
  esac
done

if [ "$verb" = watch ]; then
  qq_resolve_bin watch || qq_engine_error "$QQ_BIN_ERROR"; watch_bin="$QQ_BIN_RESULT"
  qq_resolve_bin backlog || qq_engine_error "$QQ_BIN_ERROR"; backlog_bin="$QQ_BIN_RESULT"
  qq_resolve_bin bash || qq_engine_error "$QQ_BIN_ERROR"; bash_bin="$QQ_BIN_RESULT"
  exec "$watch_bin" --no-title --interval "$interval" --exec "$bash_bin" -c '
    "$1" reconcile --repo "$2" >/dev/null 2>&1 || exit $?
    cd "$3" || exit 1
    exec "$4" board
  ' qq-board-watch "$self" "$repo_root" "$scratch_root" "$backlog_bin"
fi

read_task_metadata() {
  awk '
    function scalar(line,key,value,quote) {
      sub("^" key ":[[:space:]]*", "", line); sub("[[:space:]]+$", "", line)
      value=line; quote=substr(value,1,1)
      if ((quote == "\"" || quote == "\047") && substr(value,length(value),1) == quote)
        value=substr(value,2,length(value)-2)
      return value
    }
    NR == 1 && $0 == "---" { frontmatter=1; next }
    frontmatter && $0 == "---" { closed=1; exit }
    frontmatter && /^id:[[:space:]]*/ { id=scalar($0,"id") }
    frontmatter && /^status:[[:space:]]*/ { status=scalar($0,"status") }
    END { if (!frontmatter || !closed || id == "" || status == "") exit 65; printf "%s\t%s\n",id,status }
  ' "$1"
}
data_refuse() { local state="${2-}"; qq_engine_finish 65 refused "$1" "${state:-\{\}}"; }

shopt -s nullglob; task_files=("$primary_tasks_dir"/*.md); shopt -u nullglob
task_names=(); for path in "${task_files[@]}"; do task_names+=("${path##*/}"); done
if ! identity_json="$("$python_bin" "$identity_helper" filenames --repo "$repo_root" "${task_names[@]}" 2>&1)"; then
  state="$("$QQ_ENGINE_JQ" -cn --arg detail "$identity_json" '{detail:$detail}')"
  data_refuse 'A Task filename does not expose a configured parent or direct-child identity.' "$state"
fi
identity_records="$("$QQ_ENGINE_JQ" -r 'if (.identities | type) == "array" then .identities[] | [.input,.display_id] | @tsv else error("invalid identities") end' <<<"$identity_json")" \
  || qq_engine_error 'Task identity helper returned malformed filename data.'
declare -A expected_by_name=() seen_ids=()
while IFS=$'\t' read -r name task_id; do [ -n "$name" ] && expected_by_name["$name"]="$task_id"; done <<<"$identity_records"
task_ids=(); statuses=(); hashes=(); tasks='[]'
for index in "${!task_files[@]}"; do
  path="${task_files[$index]}"; name="${task_names[$index]}"; expected="${expected_by_name[$name]-}"
  [ -n "$expected" ] || qq_engine_error "Task identity helper omitted a Task filename: $path"
  metadata="$(read_task_metadata "$path")" || data_refuse 'Task record has unreadable id or status frontmatter.'
  IFS=$'\t' read -r task_id status <<<"$metadata"
  [ "$task_id" = "$expected" ] || data_refuse 'Task filename and frontmatter id disagree.' \
    "$("$QQ_ENGINE_JQ" -cn --arg task_file "$path" --arg expected_id "$expected" --arg stored_id "$task_id" '{task_file:$task_file,expected_id:$expected_id,stored_id:$stored_id}')"
  case "$status" in
    Unaligned | Aligned | Active | 'To Do' | 'In Progress' | Done) ;;
    *) data_refuse 'Task record has an unsupported stored status.' \
    "$("$QQ_ENGINE_JQ" -cn --arg task_id "$task_id" --arg stored_status "$status" '{task_id:$task_id,stored_status:$stored_status}')" ;; esac
  [ -z "${seen_ids[$task_id]+x}" ] || data_refuse 'Duplicate Task record id in the store.'
  seen_ids["$task_id"]=1; task_ids+=("$task_id"); statuses+=("$status")
  hash="$("$sha256sum_bin" -- "$path" | awk '{print $1}')"; [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || qq_engine_error "Could not hash Task record: $path"
  hashes+=("$hash")
done

effective_dry_run=false; if [ "$mode" = inspect ] || [ "$dry_run" = true ]; then effective_dry_run=true; fi
notes='[]'; board_temp=
append_note() { notes="$("$QQ_ENGINE_JQ" -cn --argjson n "$notes" --arg v "$1" '$n+[$v]')"; }

# Board-trash expiry (T-88 disposition as amended by doc-126 Change 8):
# qq-board disposes old scratch generations into the shared cache trash and
# prunes this Repository's own entries past the retention window at
# reconcile time. Age is read from the disposal epoch written into the
# trash name, never from mtime: a long-lived generation gets its full
# retention after disposal. Foreign and unparseable entries are never
# touched, and pruning never runs under inspect or --dry-run.
prune_board_trash() {
  local trash_root entry name now_epoch disposal_epoch
  trash_root="$board_parent/.trash"
  [ -d "$trash_root" ] || return 0
  now_epoch="$(date +%s)"
  while IFS= read -r -d '' entry; do
    name="${entry##*/}"
    if [[ ! "$name" =~ ^\.?${repo_key}(\.gen\.[A-Za-z0-9]{6})?\.([0-9]+)\.[0-9]+$ ]]; then
      continue
    fi
    disposal_epoch="${BASH_REMATCH[2]}"
    [ $((now_epoch - disposal_epoch)) -gt 604800 ] || continue
    if [ -d "$entry" ] && [ ! -L "$entry" ]; then
      rm -rf -- "$entry" || append_note "Could not prune aged board trash entry: $entry"
    fi
  done < <("$find_bin" "$trash_root" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
}

disposal_eligible() {
  local target="$1" base path
  [ "${target%/*}" = "$board_parent" ] || return 1; base="${target##*/}"
  if [ "$target" != "$scratch_root" ] && [[ ! "$base" =~ ^\.${repo_key}\.gen\.[A-Za-z0-9]{6}$ ]]; then return 1; fi
  for path in "${worktree_paths[@]}"; do
    if [[ "$target/" = "$path/"* ]] || [[ "$path/" = "$target/"* ]]; then return 1; fi
  done
}
dispose_dir() {
  local target="$1"
  [ -e "$target" ] || [ -L "$target" ] || return 0
  if [ ! -d "$target" ] || [ -L "$target" ]; then append_note "Refused to dispose of a non-directory scratch target: $target"; return 1; fi
  if ! disposal_eligible "$target"; then append_note "Refused to dispose of an ineligible scratch target: $target"; return 1; fi
  mkdir -p -- "$board_parent/.trash" || return 1
  mv -- "$target" "$board_parent/.trash/${target##*/}.$(date +%s).$RANDOM"
}
cleanup() {
  case "$board_temp" in "$board_parent"/.*) dispose_dir "$board_temp" 2>/dev/null || printf 'warning: scratch generation left behind: %s\n' "$board_temp" >&2 ;; esac
}
trap cleanup EXIT
board_signature() {
  { "$sha256sum_bin" -- "$primary_config"
    for index in "${!task_ids[@]}"; do printf '%s\t%s\t%s\t%s\n' "${task_ids[$index]}" "${task_names[$index]}" "${hashes[$index]}" "${statuses[$index]}"; done
  } | "$sha256sum_bin" | awk '{print $1}'
}
materialize_board() {
  local previous_target current_signature new_signature link_temp index
  previous_target=; current_signature=
  mkdir -p -- "$board_parent" || qq_engine_error "Could not create scratch-board parent: $board_parent"
  new_signature="$(board_signature)"
  if [ -L "$scratch_root" ]; then
    previous_target="$(readlink -f -- "$scratch_root" 2>/dev/null || true)"
    [ -n "$previous_target" ] || append_note 'Could not resolve the previous scratch target; replacing the link without disposal.'
  elif [ -e "$scratch_root" ]; then
    dispose_dir "$scratch_root" || qq_engine_error "Could not dispose of the stale scratch directory: $scratch_root"
  fi
  if [ -n "$previous_target" ] && disposal_eligible "$previous_target"; then current_signature="$(cat -- "$previous_target/.signature" 2>/dev/null || true)"; fi
  if [ -n "$current_signature" ] && [ "$current_signature" = "$new_signature" ]; then append_note 'Board unchanged; kept the current generation.'; return; fi
  board_temp="$(mktemp -d "$board_parent/.${repo_key}.gen.XXXXXX")" || qq_engine_error 'Could not allocate a scratch-board generation.'
  mkdir -p -- "$board_temp/backlog/tasks" || qq_engine_error 'Could not create the scratch Backlog tree.'
  cp -- "$primary_config" "$board_temp/backlog/config.yml" || qq_engine_error 'Could not copy primary Backlog configuration.'
  for index in "${!task_files[@]}"; do cp -- "${task_files[$index]}" "$board_temp/backlog/tasks/${task_names[$index]}" || qq_engine_error "Could not copy Task record: ${task_ids[$index]}"; done
  printf '%s\n' "$new_signature" >"$board_temp/.signature" || qq_engine_error 'Could not write the scratch-board signature.'
  link_temp="$(mktemp -u "$board_parent/.${repo_key}.link.XXXXXX")" || qq_engine_error 'Could not reserve the scratch-board link name.'
  ln -s -- "$board_temp" "$link_temp" || qq_engine_error 'Could not stage the scratch-board link.'
  if ! mv -T -- "$link_temp" "$scratch_root"; then rm -f -- "$link_temp"; qq_engine_error 'Could not publish the scratch board tree.'; fi
  board_temp=; dispose_dir "$previous_target" || true
}

materialized=false
if [ "$effective_dry_run" = false ]; then
  materialize_board; materialized=true
  prune_board_trash
elif [ -L "$scratch_root" ]; then
  previous_target="$(readlink -f -- "$scratch_root" 2>/dev/null || true)"
  if [ -n "$previous_target" ] && disposal_eligible "$previous_target" \
    && [ "$(cat -- "$previous_target/.signature" 2>/dev/null || true)" = "$(board_signature)" ]; then
    append_note 'Board unchanged; kept the current generation.'
  fi
fi
for index in "${!task_ids[@]}"; do
  task="$("$QQ_ENGINE_JQ" -cn --arg id "${task_ids[$index]}" --arg filename "${task_names[$index]}" --arg status "${statuses[$index]}" \
    --argjson materialized "$materialized" '{id:$id,filename:$filename,status:$status,materialized:$materialized}')"
  tasks="$("$QQ_ENGINE_JQ" -cn --argjson tasks "$tasks" --argjson task "$task" '$tasks+[$task]')"
done
state="$("$QQ_ENGINE_JQ" -cn --arg repo_root "$repo_root" --arg scratch_root "$scratch_root" --arg config_source "$primary_config" \
  --argjson dry_run "$effective_dry_run" --argjson materialized "$materialized" --argjson notes "$notes" \
  --argjson task_count "${#task_ids[@]}" --argjson tasks "$tasks" \
  '{repo_root:$repo_root,scratch_root:$scratch_root,config_source:$config_source,dry_run:$dry_run,materialized:$materialized,notes:$notes,task_count:$task_count,tasks:$tasks}')"
if [ "$effective_dry_run" = true ]; then qq_engine_done 'derived the single-home board; the scratch tree was not changed' "$state"; fi
qq_engine_done 'materialized the single-home scratch board' "$state"
