#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH=$(realpath -e -- "${BASH_SOURCE[0]}")
ROOT=$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)
DASHBOARD_BIN="$ROOT/node_modules/@hypermemetic-ai/qq-dashboard/bin/qq-dashboard"

export QQ_PROFILE_BIN="$ROOT/bin/qq-profile"
exec "$DASHBOARD_BIN" "$@"
