#!/usr/bin/env bash
# Run one pi-subagents child in its assigned Git worktree.
# shellcheck disable=SC1091
set -euo pipefail

umask 077

fail() {
  local exit_code="$1"
  shift
  printf '[qq-dispatch] fail-closed: %s\n' "$*" >&2
  exit "$exit_code"
}

path_is_within() {
  local candidate="$1"
  local parent="$2"
  [[ "$candidate" == "$parent" || "$candidate" == "$parent"/* ]]
}

self="$(readlink -f -- "${BASH_SOURCE[0]}")" \
  || fail 64 "cannot resolve the adapter path"
bin_dir="$(cd -- "$(dirname -- "$self")" && pwd -P)" \
  || fail 64 "cannot resolve the adapter directory"
adapter_worktree="$(cd -- "$bin_dir/.." && pwd -P)" \
  || fail 64 "cannot resolve the adapter worktree"

# shellcheck source=bin/lib/qq-bin.sh
source "$bin_dir/lib/qq-bin.sh"

if ! qq_resolve_bin git; then
  fail 64 "$QQ_BIN_ERROR"
fi
git_binary="$QQ_BIN_RESULT"

git_query() {
  (
    unset "${!GIT_@}"
    "$git_binary" "$@"
  )
}

if ! adapter_repository_root="$(git_query -C "$adapter_worktree" rev-parse --show-toplevel 2>/dev/null)"; then
  fail 64 "adapter is not installed in a Git worktree"
fi
if ! adapter_repository_root="$(realpath -e -- "$adapter_repository_root" 2>/dev/null)"; then
  fail 64 "cannot resolve the adapter's Git worktree"
fi
[[ "$adapter_repository_root" == "$adapter_worktree" ]] \
  || fail 64 "adapter path does not resolve beneath its assigned worktree"

adapter_git_common_dir="$(realpath -e -- "$(git_query -C "$adapter_worktree" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" 2>/dev/null)" \
  || fail 67 "cannot resolve the adapter Git common directory"

invocation_cwd="$(pwd -P)" || fail 65 "cannot resolve the child cwd"
if ! invocation_root="$(git_query -C "$invocation_cwd" rev-parse --show-toplevel 2>/dev/null)"; then
  fail 65 "child cwd is not a Git worktree"
fi
if ! invocation_root="$(realpath -e -- "$invocation_root" 2>/dev/null)"; then
  fail 65 "cannot resolve the child cwd's Git worktree"
fi

if ! git_common_dir="$(git_query -C "$invocation_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
  fail 67 "cannot discover the Git common directory"
fi
if ! git_worktree_dir="$(git_query -C "$invocation_root" rev-parse --path-format=absolute --git-dir 2>/dev/null)"; then
  fail 67 "cannot discover the worktree Git directory"
fi
if ! git_common_dir="$(realpath -e -- "$git_common_dir" 2>/dev/null)"; then
  fail 67 "cannot resolve the Git common directory"
fi
if ! git_worktree_dir="$(realpath -e -- "$git_worktree_dir" 2>/dev/null)"; then
  fail 67 "cannot resolve the worktree Git directory"
fi

# The canonical adapter may serve any resolvable Git Repository. An adapter in
# a linked worktree may serve only worktrees sharing its own common directory.
if [[ "$git_common_dir" != "$adapter_git_common_dir" ]]; then
  adapter_git_worktree_dir="$(realpath -e -- "$(git_query -C "$adapter_worktree" rev-parse --path-format=absolute --git-dir 2>/dev/null)" 2>/dev/null)" \
    || fail 67 "cannot resolve the adapter Git worktree directory"
  [[ "$adapter_git_worktree_dir" == "$adapter_git_common_dir" ]] \
    || fail 65 "non-primary adapter may not serve an external repository"
fi

worktree="$invocation_root"

role="${PI_SUBAGENT_CHILD_AGENT:-}"
case "$role" in
  implementer) observation_phase=implementation ;;
  reviewer) observation_phase=review ;;
  researcher) observation_phase=research ;;
  observer) observation_phase=analysis ;;
  "") fail 66 "PI_SUBAGENT_CHILD_AGENT is required" ;;
  *) fail 66 "unsupported child role '$role'" ;;
esac
if [[ "$role" == "researcher" && -n "${CONTEXT7_API_KEY:-}" ]]; then
  fail 66 "researcher dispatch forbids inherited CONTEXT7_API_KEY"
fi

tree_supervisor="$bin_dir/lib/qq-process-tree-supervisor.py"
[[ -f "$tree_supervisor" && -x "$tree_supervisor" ]] \
  || fail 71 "process-tree supervisor is unavailable"

launcher_tmp_input="${TMPDIR:-/tmp}"
runtime_root_input="${QQ_DISPATCH_RUNTIME_ROOT:-$launcher_tmp_input/qq-delegate-runtime}"
[[ "$runtime_root_input" == /* ]] \
  || fail 68 "QQ_DISPATCH_RUNTIME_ROOT must be absolute"
mkdir -p -- "$runtime_root_input" \
  || fail 68 "cannot create the dispatch runtime root"
if ! runtime_root="$(realpath -e -- "$runtime_root_input" 2>/dev/null)"; then
  fail 68 "cannot resolve the dispatch runtime root"
fi
if ! system_tmp="$(realpath -e -- /tmp 2>/dev/null)"; then
  fail 68 "cannot resolve /tmp"
fi
if ! launcher_tmp="$(realpath -e -- "$launcher_tmp_input" 2>/dev/null)"; then
  fail 68 "cannot resolve the launcher temporary directory"
fi
[[ -d "$launcher_tmp" ]] \
  || fail 68 "launcher temporary path is not a directory"
path_is_within "$runtime_root" "$system_tmp" \
  || fail 68 "runtime root must stay beneath /tmp"
[[ "$runtime_root" != "$system_tmp" ]] \
  || fail 68 "runtime root may not be all of /tmp"

run_token="${PI_SUBAGENT_RUN_ID:-manual}"
run_token="${run_token//[^A-Za-z0-9._-]/_}"
run_token="${run_token:0:80}"
[[ -n "$run_token" ]] || run_token="manual"
child_index="${PI_SUBAGENT_CHILD_INDEX:-0}"
[[ "$child_index" =~ ^[0-9]+$ ]] \
  || fail 68 "PI_SUBAGENT_CHILD_INDEX must be a non-negative integer"

if [[ -v QQ_DISPATCH_RUN_DIR ]]; then
  run_dir_input="$QQ_DISPATCH_RUN_DIR"
  [[ "$run_dir_input" == /* ]] \
    || fail 68 "QQ_DISPATCH_RUN_DIR must be absolute"
  [[ ! -L "$run_dir_input" ]] \
    || fail 68 "dispatch run directory may not be a symlink"
  [[ -d "$run_dir_input" ]] \
    || fail 68 "dispatch run directory must be an existing directory"
  if ! run_dir="$(realpath -e -- "$run_dir_input" 2>/dev/null)"; then
    fail 68 "cannot resolve the dispatch run directory"
  fi
  path_is_within "$run_dir" "$runtime_root" \
    || fail 68 "dispatch run directory must stay beneath the runtime root"
  [[ "$run_dir" != "$runtime_root" ]] \
    || fail 68 "dispatch run directory may not be the runtime root"
  [[ -O "$run_dir" ]] \
    || fail 68 "dispatch run directory is not owned by the operator"
  run_dir_mode="$(stat -c %a "$run_dir")"
  [[ "$run_dir_mode" == "700" ]] \
    || fail 68 "dispatch run directory must be mode 700 (found $run_dir_mode): $run_dir"
  while IFS= read -r -d '' run_entry; do
    [[ "$(basename -- "$run_entry")" == "BRIEF.md" ]] \
      || fail 68 "dispatch run directory contains unexpected entry: $run_entry"
  done < <(find "$run_dir" -mindepth 1 -maxdepth 1 -print0)
else
  run_dir="$runtime_root/runs/$run_token/${role}-${child_index}-$$"
  mkdir -p -- "$(dirname -- "$run_dir")" \
    || fail 68 "cannot create the dispatch run parent"
  mkdir -m 700 -- "$run_dir" \
    || fail 68 "cannot create the dispatch run directory"
fi

mkdir -m 700 -- "$run_dir/cache" "$run_dir/pi-config" "$run_dir/sessions" \
  || fail 68 "cannot create the dispatch run directories"
if ! pi_config_dir="$(realpath -e -- "$run_dir/pi-config" 2>/dev/null)"; then
  fail 68 "cannot resolve the dispatch Pi config directory"
fi
path_is_within "$pi_config_dir" "$run_dir" \
  || fail 68 "dispatch Pi config directory must stay beneath the run directory"
pi_auth_path="$pi_config_dir/auth.json"
if [[ -n "${HOME:-}" ]]; then
  launcher_auth_path="$HOME/.pi/agent/auth.json"
  if [[ -f "$launcher_auth_path" ]]; then
    cp -- "$launcher_auth_path" "$pi_auth_path" \
      || fail 68 "cannot stage Pi authentication"
    chmod 600 -- "$pi_auth_path" \
      || fail 68 "cannot secure staged Pi authentication"
  fi
fi

# Delegates execute only this verified worktree's qq Pi wrapper; PATH and
# QQ_PI_BIN are not child-runtime authorities.
pi_binary="$bin_dir/pi"
[[ -f "$pi_binary" && -x "$pi_binary" && ! -L "$pi_binary" ]] \
  || fail 70 "the worktree Pi wrapper is unavailable or linked"
if [[ "$(realpath -e -- "$pi_binary" 2>/dev/null)" != "$pi_binary" ]]; then
  fail 70 "the worktree Pi wrapper does not resolve exactly"
fi
[[ "$pi_binary" != "$self" ]] \
  || fail 70 "Pi target cannot recurse into the adapter"

if ! qq_resolve_bin node; then
  fail 69 "$QQ_BIN_ERROR"
fi
node_binary="$QQ_BIN_RESULT"

canonical_manifest="$adapter_worktree/delegation/manifests/agents/$role.md"
manifest_status=0
if manifest_result="$({ "$node_binary" - "$role" "$canonical_manifest" <<'NODE'
const fs = require("node:fs");
const role = process.argv[2];
const expected = process.argv[3];
const refuse = (message, status = 1) => { process.stderr.write(message); process.exit(status); };

const rawPaths = process.env.PI_SUBAGENT_TRUSTED_AGENT_PATHS;
if (!rawPaths) refuse("PI_SUBAGENT_TRUSTED_AGENT_PATHS is required");
let trustedPaths;
try { trustedPaths = JSON.parse(rawPaths); }
catch { refuse("PI_SUBAGENT_TRUSTED_AGENT_PATHS must be valid JSON"); }
if (!trustedPaths || Array.isArray(trustedPaths) || typeof trustedPaths !== "object")
  refuse("PI_SUBAGENT_TRUSTED_AGENT_PATHS must be a JSON object");
if (!Object.prototype.hasOwnProperty.call(trustedPaths, role)
    || typeof trustedPaths[role] !== "string" || !trustedPaths[role])
  refuse(`trusted manifest path for ${role} is required`);
const manifest = trustedPaths[role];
if (manifest !== expected)
  refuse(`trusted manifest path for ${role} does not match the canonical path`);

let source;
try {
  const state = fs.lstatSync(manifest);
  if (!state.isFile() || fs.realpathSync(manifest) !== manifest) throw new Error();
  source = fs.readFileSync(manifest, "utf8");
} catch { refuse(`trusted manifest path for ${role} is unsafe or unavailable`); }

const lines = source.split("\n");
const frontmatterEnd = lines.indexOf("---", 1);
if (lines[0] !== "---" || frontmatterEnd < 0)
  refuse(`trusted manifest for ${role} has malformed YAML frontmatter`);
const frontmatter = lines.slice(1, frontmatterEnd);
const timeoutDeclarations = frontmatter.filter((line) => line.includes("timeoutMs"));
if (timeoutDeclarations.length !== 1 || !/^timeoutMs:/.test(timeoutDeclarations[0]))
  refuse(`trusted manifest for ${role} must contain exactly one timeoutMs declaration`);
const timeoutMatch = /^timeoutMs:\s*([1-9][0-9]*)\s*$/.exec(timeoutDeclarations[0]);
if (!timeoutMatch) refuse(`trusted manifest for ${role} timeoutMs must be a positive integer`);
const milliseconds = Number(timeoutMatch[1]);
if (!Number.isSafeInteger(milliseconds))
  refuse(`trusted manifest for ${role} timeoutMs cannot be converted losslessly`);

const toolDeclarations = frontmatter.filter((line) => line.includes("tools:"));
if (toolDeclarations.length !== 1 || !/^tools:/.test(toolDeclarations[0]))
  refuse(`trusted manifest for ${role} must contain exactly one tools declaration`);
const toolsText = toolDeclarations[0].slice("tools:".length).trim()
  .replace(/^\[/, "").replace(/\]$/, "");
if (!toolsText) refuse(`trusted manifest for ${role} tools declaration must not be empty`);
const tools = toolsText.split(",").map((tool) => tool.trim()).filter(Boolean);
// Deliberate choke point: every role tool must be in this adapter-owned inventory.
const knownTools = new Set([
  "read", "bash", "edit", "write", "grep", "glob", "find", "ls",
  "subagent", "subagent_wait", "intercom", "ask_user_question",
  "web_search", "web_fetch", "agent_browser", "todo", "lsp_diagnostics",
  "lens_diagnostics", "symbol_search", "module_report", "read_symbol",
  "read_enclosing", "pi_lens_activate_tools", "operator_stage", "qq_pr_watch",
  "architect_disposition",
]);
for (const tool of tools) {
  if (!knownTools.has(tool))
    refuse(`trusted manifest for ${role} declares unavailable tool '${tool}'`, 66);
}

const wholeSeconds = Math.floor(milliseconds / 1000);
const remainder = milliseconds % 1000;
const fraction = remainder
  ? `.${String(remainder).padStart(3, "0").replace(/0+$/, "")}` : "";
process.stdout.write(`${wholeSeconds}${fraction}s`);
NODE
} 2>&1)"; then
  timeout_spec="$manifest_result"
else
  manifest_status=$?
  if [[ "$manifest_status" -eq 66 ]]; then
    fail 66 "$manifest_result"
  fi
  fail 71 "$manifest_result"
fi

if [[ -v QQ_DISPATCH_TIMEOUT ]]; then
  timeout_spec="$QQ_DISPATCH_TIMEOUT"
  [[ "$timeout_spec" =~ ^(0\.[0-9]+|[1-9][0-9]*(\.[0-9]+)?)([smhd])?$ ]] \
    || fail 71 "invalid QQ_DISPATCH_TIMEOUT '$timeout_spec'"
fi
if ! qq_resolve_bin timeout; then
  fail 71 "$QQ_BIN_ERROR"
fi
timeout_binary="$QQ_BIN_RESULT"
if ! qq_resolve_bin python3; then
  fail 71 "$QQ_BIN_ERROR"
fi
python_binary="$QQ_BIN_RESULT"

# pi-subagents stores child transcripts beneath defaultSessionDir. Missing or
# malformed configuration silently falls back to the parent session tree, so
# keep this root explicit, private, and constrained to the launcher's temp dir.
if ! session_root="$("$node_binary" -e '
  try {
    const c = JSON.parse(require("fs").readFileSync(
      process.env.HOME + "/.pi/agent/extensions/subagent/config.json", "utf8"));
    if (typeof c.defaultSessionDir === "string" && c.defaultSessionDir.trim()) {
      process.stdout.write(c.defaultSessionDir);
      process.exit(0);
    }
  } catch {}
  process.exit(1);
')"; then
  fail 68 "pi-subagents defaultSessionDir is not configured; set it per README Install"
fi
[[ "$session_root" == /* ]] \
  || fail 68 "pi-subagents defaultSessionDir must be absolute: $session_root"
session_root_leaf="${session_root#"$launcher_tmp"/}"
[[ "$session_root_leaf" != "$session_root" && "$session_root_leaf" == pi-subagent-* && "$session_root_leaf" != */* ]] \
  || fail 68 "pi-subagents defaultSessionDir must be a direct pi-subagent-* child of the launcher temp dir: $session_root"
if [[ -L "$session_root" ]]; then
  fail 68 "pi-subagents session root is a symlink: $session_root"
elif [[ -e "$session_root" ]]; then
  [[ -d "$session_root" ]] \
    || fail 68 "pi-subagents session root is not a directory: $session_root"
  [[ -O "$session_root" ]] \
    || fail 68 "pi-subagents session root is not owned by the operator: $session_root"
  session_root_mode="$(stat -c %a "$session_root")"
  [[ "$session_root_mode" == "700" ]] \
    || fail 68 "pi-subagents session root must be mode 700 (found $session_root_mode): $session_root"
else
  mkdir -m 700 -- "$session_root" \
    || fail 68 "cannot create the pi-subagents session root: $session_root"
fi

export QQ_DISPATCH_WORKTREE="$worktree"
export QQ_DISPATCH_GIT_COMMON_DIR="$git_common_dir"
export QQ_DISPATCH_GIT_WORKTREE_DIR="$git_worktree_dir"
export QQ_DISPATCH_RUN_DIR="$run_dir"
export XDG_CACHE_HOME="$run_dir/cache"
export PI_CODING_AGENT_DIR="$pi_config_dir"
export PI_CODING_AGENT_SESSION_DIR="$run_dir/sessions"
export PI_OFFLINE=1

observe="$bin_dir/qq-observe"
observation_enabled=true
trace_id="${QQ_TRACE_ID:-}"
parent_span_id="${PI_PARENT_SPAN_ID:-}"
root_span_id="${PI_ROOT_SPAN_ID:-}"
if [[ -n "$trace_id" && ! "$trace_id" =~ ^[0-9a-f]{32}$ ]] \
  || [[ -n "$parent_span_id" && ! "$parent_span_id" =~ ^[0-9a-f]{16}$ ]] \
  || [[ -n "$root_span_id" && ! "$root_span_id" =~ ^[0-9a-f]{16}$ ]]; then
  printf '[qq-dispatch] observation disabled: inherited trace context is malformed\n' >&2
  unset QQ_TRACE_ID PI_PARENT_SPAN_ID PI_ROOT_SPAN_ID
  observation_enabled=false
elif [[ ! -x "$observe" ]]; then
  printf '[qq-dispatch] observation disabled: qq-observe is unavailable\n' >&2
  observation_enabled=false
else
  if [[ -z "$trace_id" ]]; then
    trace_id="$("$observe" id trace 2>/dev/null)" || observation_enabled=false
  fi
  span_id="$("$observe" id span 2>/dev/null)" || observation_enabled=false
  if $observation_enabled; then
    [[ -n "$root_span_id" ]] || root_span_id="${parent_span_id:-$span_id}"
    export QQ_TRACE_ID="$trace_id"
    export PI_ROOT_SPAN_ID="$root_span_id"
    export PI_PARENT_SPAN_ID="$span_id"
    span_start="$(date --iso-8601=ns)"
  else
    printf '[qq-dispatch] observation disabled: cannot generate trace context\n' >&2
  fi
fi

# A delegated process may inherit the accountable Architect launcher's root
# assertion. The retained fork supplies its separate trusted child assertion.
unset QQ_EXECUTION_PROFILE_LAUNCHER QQ_EXECUTION_PROFILE_LAUNCHER_ROLE

printf '[qq-dispatch] role=%s boundary=git-worktree timeout=%s run-dir=%s\n' \
  "$role" "$timeout_spec" "$run_dir" >&2

dispatch_pid=""
termination_signal=""
# shellcheck disable=SC2317  # Invoked asynchronously by the traps below.
forward_termination() {
  termination_signal="$1"
  if [[ -n "$dispatch_pid" ]]; then
    kill -s "$1" "$dispatch_pid" 2>/dev/null || true
  fi
}
trap 'forward_termination TERM' TERM
trap 'forward_termination INT' INT
trap 'forward_termination HUP' HUP

set +e
"$timeout_binary" -k 10 --signal=TERM "$timeout_spec" \
  "$python_binary" "$tree_supervisor" -- \
  "$pi_binary" --approve --offline "$@" &
dispatch_pid=$!
[[ -z "$termination_signal" ]] || forward_termination "$termination_signal"
while true; do
  wait "$dispatch_pid"
  child_status=$?
  if [[ -n "$termination_signal" ]] && kill -0 "$dispatch_pid" 2>/dev/null; then
    continue
  fi
  break
done
set -e
trap - TERM INT HUP
if [[ -n "$termination_signal" ]]; then
  case "$termination_signal" in
    HUP) child_status=129 ;;
    INT) child_status=130 ;;
    TERM) child_status=143 ;;
  esac
fi

if ! "$node_binary" - "$run_dir" "${PI_SUBAGENT_RUN_ID:-manual}" "$role" "$child_status" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
const [runDir, runId, agent, exitCodeText] = process.argv.slice(2);
const terminal = {
  schema: "qq-run-terminal",
  version: 1,
  run_id: runId,
  agent,
  exit_code: Number(exitCodeText),
  ended_at: new Date().toISOString(),
};
const target = path.join(runDir, "TERMINAL");
const temporary = path.join(runDir, `.TERMINAL.${process.pid}.tmp`);
fs.writeFileSync(temporary, `${JSON.stringify(terminal)}\n`, { mode: 0o600 });
fs.renameSync(temporary, target);
NODE
then
  printf '[qq-dispatch] fail-closed: cannot write terminal run state\n' >&2
  exit 73
fi

if $observation_enabled; then
  span_end="$(date --iso-8601=ns)"
  observation_status=ok
  [[ "$child_status" -eq 0 ]] || observation_status=error
  parent_context=()
  if [[ -n "$parent_span_id" ]]; then
    parent_context=(--parent-span-id "$parent_span_id")
  fi
  if ! "$observe" record \
    --name invoke_agent \
    --phase "$observation_phase" \
    --actor "$role" \
    --start "$span_start" \
    --end "$span_end" \
    --trace-id "$trace_id" \
    --span-id "$span_id" \
    --root-span-id "$root_span_id" \
    "${parent_context[@]}" \
    --status "$observation_status" \
    --source qq-dispatch \
    --attribute "run.id=${PI_SUBAGENT_RUN_ID:-manual}" \
    --attribute "child.index=$child_index" \
    --attribute "worktree=$worktree" \
    --attribute "exit.status=$child_status" >/dev/null; then
    printf '[qq-dispatch] observation write failed; dispatch result preserved\n' >&2
  fi
fi
exit "$child_status"
