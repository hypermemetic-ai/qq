#!/usr/bin/env bash
# Start the inactive, machine-local qq Event Plane foundation.
set -euo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
# shellcheck source=bin/lib/qq-bin.sh
source "$(dirname "$self")/lib/qq-bin.sh"

if ! qq_resolve_bin python3; then
  printf 'qq-event-plane: %s\n' "$QQ_BIN_ERROR" >&2
  exit 69
fi
exec "$QQ_BIN_RESULT" "$(dirname "$self")/lib/qq_event_plane_service.py" "$@"
