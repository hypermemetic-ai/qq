#!/usr/bin/env python3
"""Install or verify qq's one operator-owned execution-profile policy."""

from __future__ import annotations

import argparse
import os
import stat
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "delegation" / "policies" / "execution-profiles.json"
TARGET_DIR = Path.home() / ".config" / "qq"
TARGET = TARGET_DIR / "execution-profiles.json"


class PolicyFailure(RuntimeError):
    pass


def _uid() -> int:
    if not hasattr(os, "getuid"):
        raise PolicyFailure("execution-profile policy requires an attributable Unix owner")
    return os.getuid()


def _regular_source() -> bytes:
    source_stat = SOURCE.lstat()
    if not stat.S_ISREG(source_stat.st_mode) or SOURCE.is_symlink():
        raise PolicyFailure("Repository execution-profile policy is not one regular file")
    return SOURCE.read_bytes()


def _private_directory(create: bool) -> None:
    if create:
        TARGET_DIR.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        if TARGET_DIR.parent.resolve() != TARGET_DIR.parent:
            raise PolicyFailure("execution-profile policy parent must not be a symlink")
        try:
            existing = TARGET_DIR.lstat()
        except FileNotFoundError:
            TARGET_DIR.mkdir(mode=0o700)
        else:
            if not stat.S_ISDIR(existing.st_mode) or existing.st_uid != _uid():
                raise PolicyFailure("execution-profile policy directory must be operator-owned and private")
            os.chmod(TARGET_DIR, 0o700)
    directory_stat = TARGET_DIR.lstat()
    if (
        not stat.S_ISDIR(directory_stat.st_mode)
        or TARGET_DIR.resolve() != TARGET_DIR
        or directory_stat.st_uid != _uid()
        or stat.S_IMODE(directory_stat.st_mode) & 0o077
    ):
        raise PolicyFailure("execution-profile policy directory must be operator-owned and private")


def _verify_target(expected: bytes) -> None:
    _private_directory(False)
    target_stat = TARGET.lstat()
    if (
        not stat.S_ISREG(target_stat.st_mode)
        or TARGET.is_symlink()
        or target_stat.st_uid != _uid()
        or stat.S_IMODE(target_stat.st_mode) != 0o600
        or target_stat.st_nlink != 1
    ):
        raise PolicyFailure("execution-profile policy must be one operator-owned mode-600 regular file")
    if TARGET.read_bytes() != expected:
        raise PolicyFailure("active execution-profile policy differs from the Repository policy")


def install() -> None:
    expected = _regular_source()
    _private_directory(True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=".execution-profiles.", dir=TARGET_DIR)
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb", closefd=True) as stream:
            stream.write(expected)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, TARGET)
        directory_descriptor = os.open(TARGET_DIR, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    finally:
        if temporary.exists():
            temporary.unlink()
    _verify_target(expected)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("install", "verify", "path"))
    args = parser.parse_args()
    try:
        if args.action == "install":
            install()
        elif args.action == "verify":
            _verify_target(_regular_source())
        print(TARGET)
        return 0
    except (OSError, PolicyFailure) as error:
        print(f"qq-execution-profiles: {error}", file=os.sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
