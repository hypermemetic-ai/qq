#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
old=${QQ_HERDR_OLD_BIN:-/home/linuxbrew/.linuxbrew/opt/herdr/bin/herdr}
new=${QQ_HERDR_NEW_BIN:-$HOME/.local/lib/qq/herdr/bin/herdr}
sock=${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}
live_config=${QQ_HERDR_LIVE_CONFIG:-$HOME/.config/herdr/config.toml}
local_cli=${QQ_HERDR_LOCAL_CLI:-$HOME/.local/bin/herdr}
service=${QQ_HERDR_SERVICE:-$HOME/.config/systemd/user/herdr.service}
tmp=$(mktemp -d)
committed=0
had_local=0

cleanup() {
  local rc=$?
  trap - EXIT
  if [[ $rc -ne 0 && $committed -eq 0 ]]; then
    install -m 0644 "$tmp/config.before" "$live_config"
    if [[ $had_local -eq 1 ]]; then
      rm -f "$local_cli"
      cp -a "$tmp/herdr.before" "$local_cli"
    else
      rm -f "$local_cli"
    fi
    HERDR_ENV=1 HERDR_SOCKET_PATH="$sock" "$old" server reload-config >/dev/null 2>&1 || true
  fi
  rm -rf "$tmp"
  exit "$rc"
}
trap cleanup EXIT

[[ $("$new" --version) == "herdr 0.8.0" ]]
[[ $(systemctl --user show herdr.service -p ActiveState --value) == inactive ]] || {
  echo 'refusing live handoff while herdr.service owns the server cgroup' >&2
  exit 1
}
mapfile -t server_pids < <(pgrep -f '/home/linuxbrew/.linuxbrew/(Cellar|opt)/herdr/.*/herdr server')
[[ ${#server_pids[@]} -eq 1 ]] || {
  echo "expected one Homebrew Herdr server, found ${#server_pids[@]}" >&2
  exit 1
}
grep -q 'app-ghostty-.*\.scope' "/proc/${server_pids[0]}/cgroup" || {
  echo 'refusing handoff because the current server is not in the Ghostty scope' >&2
  exit 1
}

mkdir -p "$(dirname "$live_config")" "$(dirname "$local_cli")" "$(dirname "$service")"
cp "$live_config" "$tmp/config.before"
if [[ -e $local_cli || -L $local_cli ]]; then
  had_local=1
  cp -a "$local_cli" "$tmp/herdr.before"
fi
env -u HERDR_ENV HERDR_SOCKET_PATH="$sock" "$old" api snapshot >"$tmp/before.json"
python3 - "$sock" "$tmp/before.json" "$tmp/processes.before.json" <<'PY'
import json
import socket
import sys

socket_path, snapshot_path, output_path = sys.argv[1:]
with open(snapshot_path) as handle:
    panes = json.load(handle)["result"]["snapshot"]["panes"]
processes = {}
for pane in panes:
    pane_id = pane["pane_id"]
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.connect(socket_path)
        request = {
            "id": f"activate:process:{pane_id}",
            "method": "pane.process_info",
            "params": {"pane_id": pane_id},
        }
        client.sendall((json.dumps(request) + "\n").encode())
        response = b""
        while not response.endswith(b"\n"):
            chunk = client.recv(65536)
            if not chunk:
                raise SystemExit(f"server closed process-info request for {pane_id}")
            response += chunk
    result = json.loads(response)["result"]["process_info"]
    processes[pane_id] = result["shell_pid"]
with open(output_path, "w") as handle:
    json.dump(processes, handle, sort_keys=True)
PY
HERDR_CONFIG_PATH="$root/herdr/config.toml" "$new" config check

install -m 0644 "$root/herdr/config.toml" "$live_config"
ln -s "$new" "$tmp/herdr-link"
mv -Tf "$tmp/herdr-link" "$local_cli"

HERDR_ENV=1 HERDR_SOCKET_PATH="$sock" "$new" server live-handoff \
  --import-exe "$new" --expected-protocol 19 --expected-version 0.8.0
committed=1
install -m 0644 "$root/systemd/user/herdr.service" "$service"
systemctl --user daemon-reload

for _ in $(seq 1 100); do
  if env -u HERDR_ENV HERDR_SOCKET_PATH="$sock" "$new" api snapshot \
    >"$tmp/after.json" 2>/dev/null; then
    break
  fi
  sleep 0.1
done
[[ -s $tmp/after.json ]] || {
  echo 'Herdr 0.8 did not expose a post-handoff snapshot' >&2
  exit 1
}
python3 - "$sock" "$tmp/after.json" "$tmp/processes.after.json" <<'PY'
import json
import socket
import sys

socket_path, snapshot_path, output_path = sys.argv[1:]
with open(snapshot_path) as handle:
    panes = json.load(handle)["result"]["snapshot"]["panes"]
processes = {}
for pane in panes:
    pane_id = pane["pane_id"]
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.connect(socket_path)
        request = {
            "id": f"activate:process:{pane_id}",
            "method": "pane.process_info",
            "params": {"pane_id": pane_id},
        }
        client.sendall((json.dumps(request) + "\n").encode())
        response = b""
        while not response.endswith(b"\n"):
            chunk = client.recv(65536)
            if not chunk:
                raise SystemExit(f"server closed process-info request for {pane_id}")
            response += chunk
    result = json.loads(response)["result"]["process_info"]
    processes[pane_id] = result["shell_pid"]
with open(output_path, "w") as handle:
    json.dump(processes, handle, sort_keys=True)
PY

python3 - "$tmp/before.json" "$tmp/after.json" \
  "$tmp/processes.before.json" "$tmp/processes.after.json" <<'PY'
import json
import sys


def snapshot(path):
    with open(path) as handle:
        return json.load(handle)["result"]["snapshot"]


before, after = map(snapshot, sys.argv[1:3])
for key, field in (
    ("workspaces", "workspace_id"),
    ("tabs", "tab_id"),
    ("panes", "pane_id"),
):
    old = {item[field] for item in before[key]}
    new = {item[field] for item in after[key]}
    if old != new:
        raise SystemExit(
            f"handoff changed {key}: before={sorted(old)} after={sorted(new)}"
        )
with open(sys.argv[3]) as handle:
    old_processes = json.load(handle)
with open(sys.argv[4]) as handle:
    new_processes = json.load(handle)
if old_processes != new_processes:
    raise SystemExit(
        f"handoff changed pane shell processes: before={old_processes} after={new_processes}"
    )
if after.get("version") != "0.8.0" or after.get("protocol") != 19:
    raise SystemExit(
        f"unexpected replacement: {after.get('version')}/{after.get('protocol')}"
    )
print(
    "Herdr 0.8 handoff preserved "
    f"{len(after['workspaces'])} spaces, {len(after['tabs'])} tabs, "
    f"and {len(after['panes'])} live pane processes."
)
PY

env -u HERDR_ENV HERDR_SOCKET_PATH="$sock" "$new" config check
printf '\nHandoff complete. Reconnect from the outer Ghostty prompt with ~/.local/bin/herdr.\n'
