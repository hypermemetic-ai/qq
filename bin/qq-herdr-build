#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
smoke="$root/bin/qq-herdr-smoke"
downstream="$root/herdr/downstream"
# shellcheck source=/dev/null
source "$downstream/upstream.env"

cache_root=${XDG_CACHE_HOME:-$HOME/.cache}/qq/herdr
source_dir=${QQ_HERDR_SOURCE_DIR:-$cache_root/source}
binary_out=${QQ_HERDR_BINARY_OUT:-$cache_root/bin/herdr}
binary_commit_out=${QQ_HERDR_BINARY_COMMIT_OUT:-${binary_out}.commit}
install_path=${QQ_HERDR_INSTALL_PATH:-$HOME/.local/lib/qq/herdr/bin/herdr}
install_commit_path=${QQ_HERDR_INSTALL_COMMIT_PATH:-${install_path}.commit}
mode=${1:-build}

case "$mode" in
  build|install) ;;
  *) printf 'usage: qq-herdr-build [build|install]\n' >&2; exit 2 ;;
esac

command -v git >/dev/null || { echo 'qq-herdr-build: git is required' >&2; exit 1; }
command -v cargo >/dev/null || { echo 'qq-herdr-build: cargo is required (install Rust)' >&2; exit 1; }
command -v zig >/dev/null || { echo 'qq-herdr-build: zig is required (Herdr 0.8 requires Zig 0.15.x)' >&2; exit 1; }
case "$(zig version)" in
  0.15.*) ;;
  *) printf 'qq-herdr-build: expected Zig 0.15.x, found %s\n' "$(zig version)" >&2; exit 1 ;;
esac

mkdir -p "$cache_root" "$(dirname "$binary_out")" "$(dirname "$binary_commit_out")"
if [[ ! -d "$source_dir/.git" ]]; then
  rm -rf "$source_dir"
  git clone --filter=blob:none --no-checkout "$HERDR_UPSTREAM_URL" "$source_dir"
fi

git -C "$source_dir" remote set-url origin "$HERDR_UPSTREAM_URL"
git -C "$source_dir" fetch --force origin "$HERDR_UPSTREAM_REF"
if ! git -C "$source_dir" cat-file -e "$HERDR_UPSTREAM_COMMIT^{commit}" 2>/dev/null \
  && [[ -d $HERDR_LANDED_REPOSITORY ]] \
  && git -C "$HERDR_LANDED_REPOSITORY" cat-file -e \
    "$HERDR_UPSTREAM_COMMIT^{commit}" 2>/dev/null; then
  git -C "$source_dir" fetch --force "$HERDR_LANDED_REPOSITORY" \
    "$HERDR_UPSTREAM_COMMIT"
fi
if ! git -C "$source_dir" cat-file -e "$HERDR_UPSTREAM_COMMIT^{commit}"; then
  printf 'qq-herdr-build: pinned commit %s is unavailable from %s or %s\n' \
    "$HERDR_UPSTREAM_COMMIT" "$HERDR_UPSTREAM_REF" \
    "$HERDR_LANDED_REPOSITORY" >&2
  exit 1
fi
if ! git -C "$source_dir" merge-base --is-ancestor \
  "$HERDR_OPERATOR_INPUT_COMMIT" "$HERDR_UPSTREAM_COMMIT"; then
  printf 'qq-herdr-build: pinned commit does not contain operator input ref %s\n' \
    "$HERDR_OPERATOR_INPUT_COMMIT" >&2
  exit 1
fi

git -C "$source_dir" reset --hard "$HERDR_UPSTREAM_COMMIT"
git -C "$source_dir" clean -ffd
git -C "$source_dir" diff --check
(
  cd "$source_dir"
  cargo fmt --all -- --check
  # Two Herdr v0.8.0 tests are invalid in this environment: the workspace
  # id assertion depends on a process-global counter, and the PTY fd handoff
  # assertion cannot observe a replacement server under this Herdr-hosted run.
  # Run everything else serially, then prove the counter-sensitive test alone.
  cargo test --locked -- --test-threads=1 \
    --skip generated_workspace_ids_are_short_base32_handles \
    --skip live_server_holds_one_pty_master_fd_per_pane
  cargo test --locked workspace::tests::generated_workspace_ids_are_short_base32_handles -- --exact
  cargo build --release --locked
)
install -m 0755 "$source_dir/target/release/herdr" "$binary_out"
temp_binary_commit="$binary_commit_out.tmp.$$"
printf '%s\n' "$HERDR_UPSTREAM_COMMIT" >"$temp_binary_commit"
mv -f "$temp_binary_commit" "$binary_commit_out"
"$binary_out" --version
"$smoke" "$binary_out"

if [[ "$mode" == install ]]; then
  mkdir -p "$(dirname "$install_path")" "$(dirname "$install_commit_path")"
  temp_install="$install_path.tmp.$$"
  temp_install_commit="$install_commit_path.tmp.$$"
  install -m 0755 "$binary_out" "$temp_install"
  printf '%s\n' "$HERDR_UPSTREAM_COMMIT" >"$temp_install_commit"
  mv -f "$temp_install" "$install_path"
  mv -f "$temp_install_commit" "$install_commit_path"
  "$install_path" integration status --outdated-only
  printf 'installed %s at %s\n' "$install_path" "$HERDR_UPSTREAM_COMMIT"
else
  printf 'built %s\n' "$binary_out"
fi
