#!/usr/bin/env bash
set -euo pipefail

if (($#)); then
  echo 'usage: qq-herdr-launch' >&2
  exit 2
fi

herdr="$HOME/.local/bin/herdr"
[[ -x "$herdr" ]] || {
  echo "Herdr client is not executable: $herdr" >&2
  exit 1
}

# A Ghostty started from inside Herdr inherits pane identity. Clear it so the
# new client connects as an outer client, and pin the exact title Handy uses to
# select bridge insertion instead of legacy xdotool typing.
exec env \
  -u HERDR_ENV \
  -u HERDR_PANE_ID \
  -u HERDR_TAB_ID \
  -u HERDR_WORKSPACE_ID \
  -u HERDR_SOCKET_PATH \
  ghostty --gtk-single-instance=true --title=herdr -e "$herdr"
