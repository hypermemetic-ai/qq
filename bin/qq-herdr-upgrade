#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
downstream="$root/herdr/downstream"
# shellcheck source=/dev/null
source "$downstream/upstream.env"

candidate=${1:-}
if [[ -z "$candidate" ]]; then
  candidate=$(git ls-remote --tags --refs "$HERDR_UPSTREAM_URL" 'refs/tags/qq-v*' \
    | awk '{sub("refs/tags/", "", $2); print $2}' \
    | sort -V \
    | tail -1)
fi
if [[ ! "$candidate" =~ ^qq-v[0-9]+\.[0-9]+\.[0-9]+-[1-9][0-9]*$ ]]; then
  printf 'usage: qq-herdr-upgrade [qq-vMAJOR.MINOR.PATCH-REVISION]\n' >&2
  exit 2
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
git -c advice.detachedHead=false clone --quiet --filter=blob:none --branch "$candidate" --depth 1 "$HERDR_UPSTREAM_URL" "$work/source"
commit=$(git -C "$work/source" rev-parse HEAD)
version=${candidate#qq-v}
version=${version%-*}
cat <<EOF
source:    $HERDR_UPSTREAM_URL
candidate: $candidate
ref:       refs/tags/$candidate
commit:    $commit
version:   $version

To pin this immutable fork candidate, update HERDR_UPSTREAM_REF,
HERDR_UPSTREAM_COMMIT, and HERDR_UPSTREAM_VERSION in:
  $downstream/upstream.env
Keep HERDR_OPERATOR_INPUT_COMMIT pinned until the candidate is verified to
contain that accepted seam. Then run:
  qq-herdr-build build
EOF
