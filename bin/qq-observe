    recurrence_keys(args)
elif command == "disposition-propose":
    disposition_propose(args)
elif command == "disposition-confirm":
    disposition_confirm(args)
elif command == "rounds":
    rounds(args)
else:
    fail(f"unknown package command: {command}")
