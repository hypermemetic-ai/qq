#!/usr/bin/env bash
# Analyze local Pi session JSONL and materialize Observer views from run records.
# shellcheck disable=SC1091
set -euo pipefail

umask 077

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
bin_dir="$(cd -- "$(dirname -- "$self")" && pwd -P)"
# shellcheck source=bin/lib/qq-bin.sh
source "$bin_dir/lib/qq-bin.sh"

usage() {
  cat >&2 <<'EOF'
usage:
  qq-observe facts SESSION.jsonl
  qq-observe signals SESSION.jsonl
  qq-observe validate-analysis ANALYSIS.json SESSION.jsonl [SESSION.jsonl...] \
    --facts SESSION_PATH=FACTS_PATH [--facts SESSION_PATH=FACTS_PATH...]
  qq-observe assemble --pr N --repo ROOT [--worktree-root DIR]
  qq-observe retire-session --role architect|coordinator --session SESSION.jsonl \
    --repo ROOT --retirement RETIREMENT.json
  qq-observe session-status --role architect|coordinator --session SESSION.jsonl \
    --repository OWNER/REPO
  qq-observe finalize --run DIR (--analysis FILE | --failed REASON)
  qq-observe run-finalized --pr N --repository OWNER/REPO
  qq-observe architect-context
  qq-observe recurrence-keys
  qq-observe disposition-settle --decisions FILE.json

facts, signals, and validate-analysis accept Pi v3 session JSONL. Signal
entries and unknown-entry citations are 1-based physical JSONL line numbers.
validate-analysis requires one --facts SESSION_PATH=FACTS_PATH pair per session.
facts emits token fields as integer-rounded accumulated totals (Python half-to-even);
fields with no observed value remain null. Architect views are computed by
scanning finalized analyses and their durable run records.
EOF
  exit 64
}

case "${1:-}" in
  facts | signals | validate-analysis | \
  assemble | retire-session | session-status | finalize | run-finalized | \
  architect-context | recurrence-keys | disposition-settle) command="$1"; shift ;;
  *) usage ;;
esac

if ! qq_resolve_bin python3; then
  printf 'qq-observe: %s\n' "$QQ_BIN_ERROR" >&2
  exit 69
fi
python_binary="$QQ_BIN_RESULT"

# Package assembly and delivery commands share one embedded implementation.
case "$command" in
  assemble | retire-session | session-status | finalize | run-finalized | \
  architect-context | recurrence-keys | disposition-settle)
    observer_git=""
    observer_gh=""
    observer_backlog=""
    observer_delegate=""
    if [[ "$command" == assemble || "$command" == retire-session || "$command" == architect-context || "$command" == disposition-settle ]]; then
      if ! qq_resolve_bin git; then
        printf 'qq-observe: %s\n' "$QQ_BIN_ERROR" >&2
        exit 69
      fi
      observer_git="$QQ_BIN_RESULT"
    fi
    if [[ "$command" == assemble || "$command" == retire-session ]]; then
      if ! qq_resolve_bin gh; then
        printf 'qq-observe: %s\n' "$QQ_BIN_ERROR" >&2
        exit 69
      fi
      observer_gh="$QQ_BIN_RESULT"
    fi
    if [[ "$command" == retire-session ]]; then
      if ! qq_resolve_bin qq-delegate; then
        printf 'qq-observe: %s\n' "$QQ_BIN_ERROR" >&2
        exit 69
      fi
      observer_delegate="$QQ_BIN_RESULT"
    fi
    if [[ "$command" == architect-context || "$command" == disposition-settle ]]; then
      if ! qq_resolve_bin backlog; then
        printf 'qq-observe: %s\n' "$QQ_BIN_ERROR" >&2
        exit 69
      fi
      observer_backlog="$QQ_BIN_RESULT"
    fi
    exec "$python_binary" - "$self" "$command" "$observer_git" "$observer_gh" "$observer_backlog" "$observer_delegate" "$@" <<'PY_ASSEMBLER'
import datetime as dt
import hashlib
import json
import math
import os
from pathlib import Path, PurePosixPath
import re
import stat
import subprocess
import sys
import tempfile
from urllib.parse import quote

self_path, command, git_binary, gh_binary, backlog_binary, delegate_binary, *args = sys.argv[1:]
sys.dont_write_bytecode = True
sys.path.insert(0, os.fspath(Path(self_path).resolve().parent / "lib"))
SAFE_COMPONENT = re.compile(r"^[A-Za-z0-9._-]+$")
SESSION_UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
PR_MERGE = re.compile(r"^Merge pull request #(\d+)\b")
PR_SQUASH = re.compile(r"(?:^|\s)\(#(\d+)\)$")
STATUS_CAP = 1024 * 1024
FIRST_LINE_CAP = 1024 * 1024
ACCOUNTABLE_SESSION_CAP = 16 * 1024 * 1024
ACCOUNTABLE_ROLES = ("architect", "coordinator")
LENS_NAMES = ("Simplicity", "Fidelity", "Trustworthiness", "Efficiency")


def fail(message, status=64):
    print(f"qq-observe: {message}", file=sys.stderr)
    raise SystemExit(status)


def emit(value, status=0):
    print(json.dumps(value, separators=(",", ":"), sort_keys=True))
    raise SystemExit(status)


def parse_flags(values, valued):
    result = {}
    index = 0
    while index < len(values):
        flag = values[index]
        if flag not in valued or index + 1 >= len(values):
            fail(f"invalid or incomplete option: {flag}")
        if flag in result:
            fail(f"duplicate option: {flag}")
        result[flag] = values[index + 1]
        index += 2
    return result


def canonical_existing(value, label, directory=False):
    if not isinstance(value, str) or not value or not os.path.isabs(value):
        fail(f"{label} must be an absolute path")
    try:
        path = Path(value).resolve(strict=True)
    except (OSError, RuntimeError, ValueError) as error:
        fail(f"cannot resolve {label}: {error}")
    try:
        mode = path.stat().st_mode
    except OSError as error:
        fail(f"cannot inspect {label}: {error}")
    if directory and not stat.S_ISDIR(mode):
        fail(f"{label} is not a directory: {path}")
    if not directory and not stat.S_ISREG(mode):
        fail(f"{label} is not a regular file: {path}")
    return path


def canonical_directory(value, label):
    return canonical_existing(value, label, directory=True)


def within(path, root):
    try:
        return os.path.commonpath(
            (os.fspath(path), os.fspath(root)),
        ) == os.fspath(root)
    except ValueError:
        return False


def run_process(argv, label, cwd=None, input_bytes=None):
    environment = None
    if git_binary and argv and argv[0] == git_binary:
        environment = os.environ.copy()
        environment["GIT_NO_LAZY_FETCH"] = "1"
        environment["GIT_TERMINAL_PROMPT"] = "0"
    try:
        return subprocess.run(
            argv, cwd=cwd, input=input_bytes, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, check=False, env=environment,
        )
    except OSError as error:
        fail(f"cannot run {label}: {error}", 65)


def checked(argv, label, cwd=None):
    process = run_process(argv, label, cwd=cwd)
    if process.returncode != 0:
        detail = process.stderr.decode("utf-8", "replace").strip()
        fail(f"{label} failed{': ' + detail if detail else ''}", 65)
    return process.stdout


def git_text(repo, *arguments, label="Git command"):
    raw = checked([git_binary, "-C", os.fspath(repo), *arguments], label)
    try:
        return raw.decode("utf-8").strip()
    except UnicodeDecodeError as error:
        fail(f"{label} emitted invalid UTF-8: {error}", 65)


def git_root(value):
    requested = canonical_directory(value, "Repository root")
    top = git_text(requested, "rev-parse", "--show-toplevel", label="Repository discovery")
    top = canonical_directory(top, "Git top level")
    if requested != top:
        fail(f"--repo must name the Repository root: {requested}")
    common = git_text(
        top, "rev-parse", "--path-format=absolute", "--git-common-dir",
        label="Git common-directory discovery",
    )
    common = canonical_directory(common, "Git common directory")
    return top, common


def canonical_repository(repo):
    remote = git_text(
        repo, "config", "--get", "branch.main.remote",
        label="primary-main tracking-remote inspection",
    )
    if not remote or remote == "." or not SAFE_COMPONENT.fullmatch(remote):
        fail("branch.main.remote must name one configured non-local remote", 65)
    remote_names = git_text(repo, "remote", label="Git remote inventory").splitlines()
    if remote not in remote_names or remote_names.count(remote) != 1:
        fail("branch.main.remote does not resolve to one configured remote", 65)
    url = git_text(
        repo, "remote", "get-url", remote,
        label="primary-main remote URL inspection",
    )
    if not url or "\n" in url:
        fail("primary-main tracking remote has no canonical URL", 65)
    response = run_process(
        [gh_binary, "repo", "view", url, "--json", "nameWithOwner"],
        "GitHub Repository inspection",
    )
    if response.returncode != 0:
        detail = response.stderr.decode("utf-8", "replace").strip()
        fail(f"GitHub Repository inspection failed{': ' + detail if detail else ''}", 65)
    record = json_document(response.stdout, "GitHub Repository inspection JSON")
    repository = record.get("nameWithOwner") if isinstance(record, dict) else None
    if not isinstance(repository, str):
        fail("GitHub Repository inspection lacks nameWithOwner", 65)
    parts = repository.split("/")
    if (
        len(parts) != 2
        or any(not part or part in (".", "..") or not SAFE_COMPONENT.fullmatch(part) for part in parts)
    ):
        fail("GitHub Repository identity must contain two safe path components", 65)
    return repository


def qualified_runs_root(runs_root, repository, create=False):
    owner, name = repository.split("/")
    root = runs_root / "by-repository" / owner / name
    if create:
        ensure_directory(root, runs_root)
        root = root.resolve(strict=True)
        if not within(root, runs_root):
            fail("qualified run root escapes observer runs root", 65)
    return root


def repository_run_dir(runs_root, repository, pr, create_root=False):
    return qualified_runs_root(runs_root, repository, create=create_root) / f"pr-{pr}"


def accountable_run_token(repository, role, session_path):
    identity = f"{repository}\0{role}\0{os.path.realpath(session_path)}".encode()
    return hashlib.sha256(identity).hexdigest()[:32]


def accountable_run_name(repository, role, session_path):
    return f"session-{role}-{accountable_run_token(repository, role, session_path)}"


def accountable_run_dir(runs_root, repository, role, session_path, create_root=False):
    return qualified_runs_root(
        runs_root, repository, create=create_root,
    ) / accountable_run_name(repository, role, session_path)


def nearest_existing(path):
    candidate = path
    while not candidate.exists():
        parent = candidate.parent
        if parent == candidate:
            break
        candidate = parent
    return candidate


def observer_runs_root(create=False):
    state_value = os.environ.get("XDG_STATE_HOME")
    if state_value is None:
        home = os.environ.get("HOME")
        if not home:
            fail("HOME is required when XDG_STATE_HOME is unset", 65)
        state_value = os.path.join(home, ".local", "state")
    if not os.path.isabs(state_value):
        fail("state home must be absolute", 65)
    state_root = Path(os.path.realpath(state_value))
    candidate = Path(os.path.realpath(os.path.join(state_value, "qq", "observer", "runs")))
    if not within(candidate, state_root):
        fail(f"observer store escapes the resolved state root: {candidate}", 65)
    if git_binary:
        existing = nearest_existing(candidate)
        probe = run_process(
            [git_binary, "-C", os.fspath(existing), "rev-parse", "--show-toplevel"],
            "observer-store containment probe",
        )
        if probe.returncode == 0:
            try:
                containing = Path(probe.stdout.decode("utf-8").strip()).resolve(strict=True)
            except (OSError, UnicodeDecodeError, RuntimeError, ValueError):
                fail("cannot resolve observer-store containing worktree", 65)
            if within(candidate, containing):
                fail(f"refusing observer store inside Git worktree: {candidate}", 65)
    if create:
        state_parent = nearest_existing(state_root)
        ensure_directory(state_root, state_parent)
        ensure_directory(candidate, state_root)
        resolved = candidate.resolve(strict=True)
        if not within(resolved, state_root):
            fail(f"observer store escapes the resolved state root: {resolved}", 65)
        return resolved
    return candidate


def ensure_directory(path, root=None):
    path = Path(path)
    if root is None:
        root = nearest_existing(path)
    root = Path(root)
    if not within(Path(os.path.realpath(path)), Path(os.path.realpath(root))):
        fail(f"directory escapes its root: {path}", 65)
    try:
        root_info = os.lstat(root)
    except OSError as error:
        fail(f"cannot inspect directory root {root}: {error}", 65)
    if not stat.S_ISDIR(root_info.st_mode):
        fail(f"directory root is not a directory: {root}", 65)
    relative = Path(os.path.relpath(path, root))
    current = root
    for part in relative.parts:
        if part in ("", "."):
            continue
        if part == "..":
            fail(f"directory escapes its root: {path}", 65)
        current = current / part
        try:
            info = os.lstat(current)
        except FileNotFoundError:
            try:
                os.mkdir(current, 0o700)
            except FileExistsError:
                pass
            except OSError as error:
                fail(f"cannot create directory {current}: {error}", 65)
            info = os.lstat(current)
        except OSError as error:
            fail(f"cannot inspect directory {current}: {error}", 65)
        if not stat.S_ISDIR(info.st_mode):
            fail(f"observer path component is not a directory: {current}", 65)


def read_regular(path, label):
    path = Path(path)
    try:
        info = os.lstat(path)
    except OSError as error:
        fail(f"cannot inspect {label}: {error}")
    if not stat.S_ISREG(info.st_mode):
        fail(f"{label} is not a regular file: {path}")
    flags = os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(path, flags)
    except OSError as error:
        fail(f"cannot open {label}: {error}")
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            fail(f"{label} is not a regular file: {path}")
        chunks = []
        while True:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        return b"".join(chunks)
    finally:
        os.close(fd)


def existing_bytes(path):
    try:
        os.lstat(path)
    except FileNotFoundError:
        return None
    return read_regular(path, f"append-only destination {path}")


def preflight_append(path, data):
    old = existing_bytes(path)
    if old is not None and old != data:
        fail(f"append-only conflict at {path}", 65)
    return old is not None


def atomic_append(path, data, content_idempotent=True):
    path = Path(path)
    ensure_directory(path.parent)
    if content_idempotent:
        if preflight_append(path, data):
            return False
    elif existing_bytes(path) is not None:
        return False
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    temporary = None
    try:
        for _ in range(100):
            name = f".{path.name}.tmp-{os.getpid()}-{os.urandom(8).hex()}"
            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
            try:
                fd = os.open(name, flags, 0o600, dir_fd=directory)
                temporary = name
                break
            except FileExistsError:
                continue
        else:
            fail(f"cannot allocate temporary file for {path}", 65)
        try:
            view = memoryview(data)
            while view:
                written = os.write(fd, view)
                view = view[written:]
            os.fsync(fd)
        finally:
            os.close(fd)
        try:
            os.link(temporary, path.name, src_dir_fd=directory, dst_dir_fd=directory,
                    follow_symlinks=False)
        except FileExistsError:
            if content_idempotent:
                if read_regular(path, f"append-only destination {path}") != data:
                    fail(f"append-only conflict at {path}", 65)
            return False
        os.fsync(directory)
        return True
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary, dir_fd=directory)
            except FileNotFoundError:
                pass
        os.close(directory)


def json_document(raw, label):
    try:
        return json.loads(
            raw.decode("utf-8"),
            parse_constant=lambda value: (_ for _ in ()).throw(
                ValueError(f"invalid JSON constant: {value}")
            ),
        )
    except (UnicodeDecodeError, ValueError, RecursionError) as error:
        fail(f"cannot read {label}: {error}")


def regular_file(path):
    try:
        return stat.S_ISREG(os.lstat(path).st_mode)
    except OSError:
        return False


def accountable_session(session_id):
    identity = f"accountable session path {session_id}"
    if os.path.isabs(session_id):
        matches = [Path(session_id)]
    else:
        if not SESSION_UUID.fullmatch(session_id):
            raise ValueError("sessionId is neither an absolute path nor a Pi session UUID")
        identity = f"accountable session UUID {session_id}"
        home = os.environ.get("HOME")
        if not home or not os.path.isabs(home):
            return None, f"{identity} requires an absolute HOME"
        sessions_root = Path(home) / ".pi" / "agent" / "sessions"
        try:
            sessions_root = sessions_root.resolve(strict=True)
            suffix = f"_{session_id}.jsonl"
            matches = [
                candidate
                for directory in sessions_root.iterdir()
                if stat.S_ISDIR(os.lstat(directory).st_mode)
                for candidate in directory.iterdir()
                if candidate.name.endswith(suffix)
                and stat.S_ISREG(os.lstat(candidate).st_mode)
            ]
        except (OSError, RuntimeError, ValueError):
            return None, f"{identity} could not scan {sessions_root}"
        if len(matches) != 1:
            return None, (
                f"{identity} matched {len(matches)} regular files under {sessions_root}"
            )
    candidate = matches[0]
    if not regular_file(candidate):
        return None, f"{identity} is missing or not a regular file"
    valid, reason = pi_first_record(candidate)
    if not valid:
        return None, f"{identity} is not Pi v3: {reason}"
    return Path(os.path.realpath(candidate)), None


def time_value(value):
    if isinstance(value, bool):
        raise ValueError("not a timestamp")
    if isinstance(value, (int, float)):
        seconds = value / 1000 if abs(value) >= 100_000_000_000 else value
        try:
            return dt.datetime.fromtimestamp(seconds, dt.timezone.utc)
        except (OverflowError, OSError, ValueError) as error:
            raise ValueError("not a timestamp") from error
    if not isinstance(value, str):
        raise ValueError("not a timestamp")
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as error:
        raise ValueError("not an ISO timestamp") from error
    if parsed.tzinfo is None:
        raise ValueError("requires a timezone")
    return parsed.astimezone(dt.timezone.utc)


def parse_time(value, label):
    try:
        return time_value(value)
    except ValueError as error:
        fail(f"{label} {error}")


def utc_now():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def pi_first_record(path):
    try:
        with Path(path).open("rb") as source:
            raw = source.readline(FIRST_LINE_CAP + 1)
    except OSError:
        return False, "cannot read JSONL"
    if len(raw) > FIRST_LINE_CAP:
        return False, "first JSONL record exceeds size limit"
    if not raw.strip():
        return False, "empty JSONL"
    try:
        item = json.loads(raw.decode("utf-8-sig"))
    except (UnicodeDecodeError, ValueError, RecursionError):
        return False, "malformed first JSONL record"
    if not isinstance(item, dict) or item.get("type") != "session" or item.get("version") != 3:
        return False, "first record is not a Pi v3 session header"
    return True, ""


def git_paths(repo, commit, *pathspecs):
    raw = checked(
        [git_binary, "-C", os.fspath(repo), "ls-tree", "-r", "-z", "--name-only",
         commit, "--", *pathspecs],
        "merge-commit tree inventory",
    )
    paths = []
    for value in raw.split(b"\0"):
        if not value:
            continue
        try:
            path = value.decode("utf-8")
        except UnicodeDecodeError as error:
            fail(f"merge-commit path is not UTF-8: {error}", 65)
        pure = PurePosixPath(path)
        if pure.is_absolute() or ".." in pure.parts:
            fail(f"unsafe merge-commit path: {path}", 65)
        paths.append(path)
    return sorted(paths)


def git_blob(repo, commit, path):
    return checked(
        [git_binary, "-C", os.fspath(repo), "show", f"{commit}:{path}"],
        f"read merge-commit path {path}",
    )


def frontmatter_description(raw):
    try:
        lines = raw.decode("utf-8").splitlines()
    except UnicodeDecodeError:
        return None
    if not lines or lines[0] != "---":
        return None
    for line in lines[1:]:
        if line == "---":
            break
        if line.startswith("description:"):
            value = line.split(":", 1)[1].strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            return value or None
    return None


def append_unknown(items, path, reason):
    row = {"path": os.fspath(path), "reason": reason}
    if row not in items:
        items.append(row)


def assemble(values):
    options = parse_flags(values, {"--pr", "--repo", "--worktree-root"})
    if "--pr" not in options or "--repo" not in options:
        fail("assemble requires --pr and --repo")
    if not re.fullmatch(r"[1-9][0-9]*", options["--pr"]):
        fail("--pr must be a positive integer")
    pr = int(options["--pr"])
    repo, common = git_root(options["--repo"])
    repository = canonical_repository(repo)
    runs_root = observer_runs_root(create=True)

    gh = run_process(
        [gh_binary, "pr", "view", str(pr), "--repo", repository, "--json",
         "headRefName,mergeCommit,mergedAt,state"],
        "pull-request inspection", cwd=repo,
    )
    if gh.returncode != 0:
        detail = gh.stderr.decode("utf-8", "replace").strip()
        fail(f"pull-request inspection failed{': ' + detail if detail else ''}", 65)
    record = json_document(gh.stdout, "pull-request inspection JSON")
    if not isinstance(record, dict) or record.get("state") != "MERGED":
        fail(f"pull request #{pr} is not verifiably MERGED", 65)
    branch = record.get("headRefName")
    merged_at_value = record.get("mergedAt")
    merge_value = record.get("mergeCommit")
    merge_commit = merge_value.get("oid") if isinstance(merge_value, dict) else merge_value
    if not isinstance(branch, str) or not branch:
        fail("merged pull request has no headRefName", 65)
    if not isinstance(merge_commit, str) or not re.fullmatch(r"[0-9a-fA-F]{7,64}", merge_commit):
        fail("merged pull request has no valid merge commit", 65)
    if not isinstance(merged_at_value, str):
        fail("merged pull request has no mergedAt timestamp", 65)
    merged_at = parse_time(merged_at_value, "mergedAt")
    checked(
        [git_binary, "-C", os.fspath(repo), "cat-file", "-e", f"{merge_commit}^{{commit}}"],
        "merge-commit verification",
    )
    merge_commit = git_text(repo, "rev-parse", f"{merge_commit}^{{commit}}",
                            label="merge-commit canonicalization")
    landed = run_process(
        [git_binary, "-C", os.fspath(repo), "merge-base", "--is-ancestor",
         merge_commit, "main"],
        "merge-commit main ancestry verification",
    )
    if landed.returncode != 0:
        detail = landed.stderr.decode("utf-8", "replace").strip()
        fail(
            f"merge commit {merge_commit} is not an ancestor of local main"
            f"{': ' + detail if detail else ''}",
            65,
        )

    run_name = f"pr-{pr}"
    run_dir = repository_run_dir(
        runs_root, repository, pr, create_root=True,
    )
    ensure_directory(run_dir, runs_root)
    ensure_directory(run_dir / "sessions", runs_root)
    package_path = run_dir / "package.json"
    existing_package = False
    if package_path.exists() or package_path.is_symlink():
        package = json_document(read_regular(package_path, "observer package"), "observer package")
        if (
            not isinstance(package, dict)
            or package.get("schema") != "qq-observer.package"
            or isinstance(package.get("schema_version"), bool)
            or package.get("schema_version") != 3
            or package.get("pr") != pr
            or package.get("repo") != os.fspath(repo)
            or package.get("repository") != repository
            or package.get("branch") != branch
            or package.get("merge_commit") != merge_commit
            or package.get("variant", "guided") != "guided"
            or package.get("audit_unit") != {
                "kind": "delivered_change", "repository": repository,
                "pr": pr, "branch": branch, "merge_commit": merge_commit,
                "merged_at": merged_at_value,
            }
        ):
            fail(f"append-only conflict at {package_path}", 65)
        existing_package = True
    for marker in ("analysis.json", "analysis_failed.json"):
        marker_path = run_dir / marker
        if marker_path.exists() or marker_path.is_symlink():
            read_regular(marker_path, f"finalized analysis {marker_path}")
            emit({"status": "already finalized", "run_dir": os.fspath(run_dir)})
    if existing_package:
        emit({"status": "already assembled", "run_dir": os.fspath(run_dir)})

    if "--worktree-root" in options:
        worktree_value = options["--worktree-root"]
    else:
        home = os.environ.get("HOME")
        if not home:
            fail("HOME is required for the default worktree root", 65)
        worktree_value = os.path.join(
            home, ".herdr", "worktrees", common.parent.name,
        )
    if not os.path.isabs(worktree_value):
        fail("worktree root must be absolute")
    worktree_root = Path(os.path.realpath(worktree_value))
    if worktree_root.exists() and not worktree_root.is_dir():
        fail(f"worktree root is not a directory: {worktree_root}")

    # qq-delegate owns the dispatch runtime root contract; the observer
    # follows the same default (durable qq state, not volatile /tmp).
    runtime_value = os.environ.get("QQ_DISPATCH_RUNTIME_ROOT")
    if runtime_value is None:
        state_home = os.environ.get("XDG_STATE_HOME") or os.path.join(
            os.path.expanduser("~"), ".local", "state"
        )
        runtime_value = os.path.join(state_home, "qq", "delegate")
    if not os.path.isabs(runtime_value):
        fail("dispatch runtime root must be absolute", 65)
    runtime = Path(os.path.realpath(runtime_value))
    selected_runs = {}
    terminal_records = {}
    unknown = []
    warnings = []
    window_start = merged_at - dt.timedelta(days=30)
    window_end = merged_at + dt.timedelta(days=1)
    zero_session_id = "00000000-0000-0000-0000-000000000000"

    if runtime.exists():
        try:
            runtime_info = os.lstat(runtime)
        except OSError as error:
            fail(f"cannot inspect dispatch runtime root {runtime}: {error}", 65)
        if not stat.S_ISDIR(runtime_info.st_mode):
            fail(f"dispatch runtime root is not a directory: {runtime}", 65)
        try:
            runtime_entries = sorted(runtime.iterdir(), key=lambda item: item.name)
        except OSError as error:
            fail(f"cannot enumerate dispatch runtime root {runtime}: {error}", 65)
        for entry in runtime_entries:
            try:
                entry_info = os.lstat(entry)
            except OSError:
                continue
            if not stat.S_ISDIR(entry_info.st_mode):
                continue
            terminal_path = entry / "TERMINAL"
            if not regular_file(terminal_path):
                continue
            if not SAFE_COMPONENT.fullmatch(entry.name) or entry.name in (".", ".."):
                append_unknown(unknown, terminal_path, "unsafe delegate run directory")
                continue
            try:
                raw = read_regular(terminal_path, "delegate terminal")
                if len(raw) > STATUS_CAP:
                    raise ValueError("TERMINAL exceeds size limit")
                terminal = json.loads(
                    raw.decode("utf-8"),
                    parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)),
                )
                if not isinstance(terminal, dict):
                    raise ValueError("top level is not an object")
                run_id = terminal.get("run_id")
                agent = terminal.get("agent")
                cwd_value = terminal.get("cwd")
                exit_code = terminal.get("exit_code")
                run_dir_value = terminal.get("run_dir")
                sessions_dir_value = terminal.get("sessions_dir")
                if terminal.get("schema") != "qq-run-terminal" or terminal.get("version") != 2:
                    raise ValueError("schema or version is invalid")
                if (
                    not isinstance(run_id, str)
                    or not SAFE_COMPONENT.fullmatch(run_id)
                    or run_id in (".", "..")
                ):
                    raise ValueError("run_id is unsafe")
                if not isinstance(agent, str):
                    raise ValueError("agent is not a string")
                if not isinstance(cwd_value, str) or not os.path.isabs(cwd_value):
                    raise ValueError("cwd is not an absolute path")
                if isinstance(exit_code, bool) or not isinstance(exit_code, int):
                    raise ValueError("exit_code is not an integer")
                started_at = time_value(terminal.get("started_at"))
                time_value(terminal.get("ended_at"))
                if not isinstance(terminal.get("timed_out"), bool):
                    raise ValueError("timed_out is not a boolean")
                if not isinstance(run_dir_value, str) or not os.path.isabs(run_dir_value):
                    raise ValueError("run_dir is not an absolute path")
                if Path(os.path.realpath(run_dir_value)) != Path(os.path.realpath(entry)):
                    raise ValueError("run_dir does not name the containing directory")
                if not isinstance(sessions_dir_value, str) or not os.path.isabs(sessions_dir_value):
                    raise ValueError("sessions_dir is not an absolute path")
                if run_id in terminal_records:
                    raise ValueError("run_id is duplicated")
                if "parent_session" not in terminal or terminal.get("parent_session") in ("", zero_session_id):
                    parent = None
                    parent_issue = None
                    parent_unavailable = True
                else:
                    parent_session = terminal.get("parent_session")
                    if not isinstance(parent_session, str):
                        raise ValueError("parent_session is not a string")
                    parent, parent_issue = accountable_session(parent_session)
                    parent_unavailable = False
            except (OSError, UnicodeDecodeError, ValueError, RecursionError):
                append_unknown(unknown, terminal_path, "malformed delegate TERMINAL")
                continue
            if parent_unavailable:
                warnings.append(f"delegate {run_id} accountable session is unavailable")
            elif parent_issue is not None:
                append_unknown(unknown, terminal_path, parent_issue)
                warnings.append(
                    f"delegate {run_id} accountable session is unavailable: {parent_issue}"
                )
            cwd_path = Path(os.path.realpath(cwd_value))
            terminal_records[run_id] = {
                "path": terminal_path, "parent": parent, "cwd": cwd_path,
                "started": started_at,
                "sessions_dir": Path(os.path.realpath(sessions_dir_value)),
            }

            live_common = None
            branch_process = None
            if cwd_path.is_dir():
                common_process = run_process(
                    [git_binary, "-C", os.fspath(cwd_path), "rev-parse",
                     "--path-format=absolute", "--git-common-dir"],
                    "delegate worktree inspection",
                )
                if common_process.returncode == 0:
                    try:
                        live_common = Path(
                            common_process.stdout.decode("utf-8").strip()
                        ).resolve(strict=True)
                    except (OSError, UnicodeDecodeError, RuntimeError, ValueError):
                        live_common = None
                    branch_process = run_process(
                        [git_binary, "-C", os.fspath(cwd_path), "symbolic-ref", "--short", "HEAD"],
                        "delegate branch inspection",
                    )
            branch_readable = branch_process is not None and branch_process.returncode == 0
            if live_common == common and branch_readable:
                try:
                    observed_branch = branch_process.stdout.decode("utf-8").strip()
                except UnicodeDecodeError:
                    observed_branch = ""
                if observed_branch == branch:
                    selected_runs[run_id] = "named-branch-terminal-lineage"
                else:
                    append_unknown(
                        unknown, terminal_path,
                        "delegate terminal names another branch in this Repository",
                    )
                    warnings.append(
                        f"delegate {run_id} is outside the explicit named-branch lineage"
                    )
                continue
            if within(cwd_path, worktree_root) and window_start <= started_at <= window_end:
                append_unknown(
                    unknown, terminal_path,
                    "delegate terminal does not verify the named branch checkout",
                )
                warnings.append(
                    f"delegate {run_id} is outside the explicit named-branch lineage"
                )

    session_rows = []
    session_sources = set()
    label_sources = {}

    def add_session(source, label, role, evidence, run_id=None):
        source = Path(os.path.realpath(source))
        if source in session_sources:
            return
        if not regular_file(source):
            append_unknown(unknown, source, "selected session is missing or non-regular")
            warnings.append(f"selected {role} session is unavailable: {source}")
            return
        valid, reason = pi_first_record(source)
        if not valid:
            append_unknown(unknown, source, reason)
            warnings.append(f"selected {role} session is not Pi v3: {source}")
            return
        if not SAFE_COMPONENT.fullmatch(label) or label in (".", ".."):
            append_unknown(unknown, source, "session label is unsafe")
            return
        previous = label_sources.get(label)
        if previous is not None and previous != source:
            suffix = hashlib.sha256(os.fsencode(source)).hexdigest()[:12]
            label = f"{label}-{suffix}"
            previous = label_sources.get(label)
            if previous is not None and previous != source:
                fail(f"session label collision for {label}", 65)
        label_sources[label] = source
        session_sources.add(source)
        row = {
            "label": label, "source": source, "role": role, "evidence": evidence,
        }
        if run_id is not None:
            row["run_id"] = run_id
        session_rows.append(row)

    for run_id in sorted(selected_runs):
        parent = terminal_records[run_id]["parent"]
        if parent is not None:
            stem = parent.stem
            identifier = stem.rsplit("_", 1)[-1]
            add_session(parent, f"accountable-{identifier}", "accountable", "parent-of-delegate")

    for run_id in sorted(selected_runs):
        record = terminal_records[run_id]
        sessions_dir = record["sessions_dir"]
        session_files = []
        try:
            sessions_info = os.lstat(sessions_dir)
            if stat.S_ISDIR(sessions_info.st_mode):
                for candidate in sessions_dir.rglob("*.jsonl"):
                    try:
                        candidate_info = os.lstat(candidate)
                    except OSError:
                        continue
                    if stat.S_ISREG(candidate_info.st_mode):
                        session_files.append((candidate_info.st_mtime_ns, os.fspath(candidate), candidate))
        except (OSError, RuntimeError, ValueError):
            session_files = []
        if not session_files:
            append_unknown(
                unknown, record["path"],
                "delegate sessions_dir contains no regular JSONL session",
            )
            warnings.append(f"delegate {run_id} has no valid explicit sessionFile lineage")
            continue
        session_file = max(session_files)[2]
        add_session(
            session_file, f"delegate-{run_id}-primary", "delegate",
            selected_runs[run_id], run_id=run_id,
        )

    if not selected_runs:
        warnings.append("no delegate runs have explicit named-branch terminal lineage")

    session_rows.sort(key=lambda row: (0 if row["role"] == "accountable" else 1, row["label"]))

    # The audit unit is a Change: an accountable member is packaged as the
    # suffix from the Change's first dispatch plus the originating operator
    # brief (the last user entry before that dispatch), never the whole
    # cross-Change session. Delegate sessions are Change-scoped by
    # construction and copied whole.
    earliest_started = None
    for run_id in selected_runs:
        started = terminal_records[run_id]["started"]
        if earliest_started is None or started < earliest_started:
            earliest_started = started

    def change_bounded(raw):
        lines = raw.splitlines(keepends=True)
        bound = None
        for index, line in enumerate(lines):
            try:
                entry = json.loads(line)
                stamp = time_value(entry.get("timestamp")) if isinstance(entry, dict) else None
            except (ValueError, RecursionError):
                continue
            if stamp is not None and stamp >= earliest_started:
                bound = index
                break
        if bound is None or bound == 0:
            return raw, bound, None
        brief = None
        for index in range(bound - 1, 0, -1):
            try:
                entry = json.loads(lines[index])
            except (ValueError, RecursionError):
                continue
            if (
                isinstance(entry, dict) and entry.get("type") == "message"
                and isinstance(entry.get("message"), dict)
                and entry["message"].get("role") == "user"
            ):
                brief = index
                break
        included = [lines[0]]
        if brief is not None:
            included.append(lines[brief])
        included.extend(lines[bound:])
        return b"".join(included), bound, brief

    packaged_sessions = []
    for row in session_rows:
        label = row["label"]
        source = row["source"]
        session_rel = f"sessions/{label}.jsonl"
        data = read_regular(source, "selected session transcript")
        bound = brief = None
        if row["role"] == "accountable" and earliest_started is not None:
            data, bound, brief = change_bounded(data)
            if bound is None:
                warnings.append(
                    f"accountable session {label} could not be Change-bounded: "
                    "no entries at or after the first dispatch"
                )
        atomic_append(run_dir / session_rel, data)
        package_row = {
            "label": label,
            "source_path": os.fspath(source),
            "role": row["role"],
            "evidence": row["evidence"],
        }
        if bound:
            package_row["bounded_from_entry"] = bound
            if brief is not None:
                package_row["bounded_brief_entry"] = brief
        if "run_id" in row:
            package_row["run_id"] = row["run_id"]
        packaged_sessions.append(package_row)

    all_paths = git_paths(repo, merge_commit, "bin", "extensions", "skills", "delegation/manifests")
    bin_names = sorted(
        PurePosixPath(path).name for path in all_paths
        if len(PurePosixPath(path).parts) == 2 and path.startswith("bin/")
    )
    extension_names = sorted(
        PurePosixPath(path).name for path in all_paths
        if len(PurePosixPath(path).parts) == 2
        and path.startswith("extensions/") and path.endswith(".ts")
    )
    skill_paths = [
        path for path in all_paths
        if len(PurePosixPath(path).parts) == 3
        and path.startswith("skills/") and path.endswith("/SKILL.md")
    ]
    skills = []
    for path in skill_paths:
        raw = git_blob(repo, merge_commit, path)
        description = frontmatter_description(raw)
        if description is None:
            append_unknown(unknown, f"git:{merge_commit}:{path}", "missing skill description")
        skills.append({
            "name": PurePosixPath(path).parts[1],
            "description": description,
        })
    manifest_names = sorted(
        path.removeprefix("delegation/manifests/") for path in all_paths
        if path.startswith("delegation/manifests/")
    )
    inventory = {
        "schema": "qq-observer.inventory",
        "schema_version": 1,
        "merge_commit": merge_commit,
        "bin": bin_names,
        "extensions": extension_names,
        "skills": skills,
        "delegation_manifests": manifest_names,
    }
    atomic_append(
        run_dir / "inventory.json",
        (json.dumps(inventory, separators=(",", ":"), sort_keys=True) + "\n").encode(),
    )

    unknown.sort(key=lambda row: (row["path"], row["reason"]))
    warnings = list(dict.fromkeys(warnings))
    package = {
        "schema": "qq-observer.package",
        "schema_version": 3,
        "audit_unit": {
            "kind": "delivered_change", "repository": repository,
            "pr": pr, "branch": branch, "merge_commit": merge_commit,
            "merged_at": merged_at_value,
        },
        "repository": repository,
        "pr": pr,
        "branch": branch,
        "merge_commit": merge_commit,
        "merged_at": merged_at_value,
        "assembled_at": utc_now(),
        "variant": "guided",
        "repo": os.fspath(repo),
        "sessions": packaged_sessions,
        "warnings": warnings,
        "unknown_entries": unknown,
    }
    atomic_append(
        package_path,
        (json.dumps(package, separators=(",", ":"), sort_keys=True) + "\n").encode(),
    )
    emit({
        "status": "assembled", "run_dir": os.fspath(run_dir),
        "sessions": len(packaged_sessions), "warnings": len(warnings),
        "unknown_entries": len(unknown), "variant": "guided",
    })


def accountable_session_document(raw, label):
    if len(raw) > ACCOUNTABLE_SESSION_CAP:
        raise ValueError(
            f"{label} exceeds the {ACCOUNTABLE_SESSION_CAP}-byte accountable-session limit"
        )
    entries = []
    for number, line in enumerate(raw.splitlines(), 1):
        if not line.strip():
            raise ValueError(f"{label} has a blank JSONL entry at line {number}")
        try:
            entry = json.loads(
                line.decode("utf-8-sig" if number == 1 else "utf-8"),
                parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)),
            )
        except (UnicodeDecodeError, ValueError, RecursionError) as error:
            raise ValueError(f"{label} has malformed JSONL at line {number}: {error}") from error
        entries.append(entry)
    if not entries:
        raise ValueError(f"{label} is empty")
    if (
        not isinstance(entries[0], dict)
        or entries[0].get("type") != "session"
        or entries[0].get("version") != 3
    ):
        raise ValueError(f"{label} does not begin with a Pi v3 session header")
    return entries


def observer_failure_bytes(reason, version=2):
    return canonical_json_bytes({
        "schema": "qq-observer.analysis", "schema_version": version,
        "status": "analysis_failed", "reason": reason,
    })


def record_observer_failure(run_dir, reason, version=2):
    target = run_dir / "analysis_failed.json"
    data = observer_failure_bytes(reason, version=version)
    if os.path.lexists(run_dir / "analysis.json"):
        fail("run already contains analysis.json", 65)
    atomic_append(target, data)


def retirement_package_failure(
    runs_root, repository, repo, role, session_path, retirement_id, reason,
):
    run_dir = accountable_run_dir(
        runs_root, repository, role, session_path, create_root=True,
    )
    ensure_directory(run_dir, runs_root)
    package = {
        "schema": "qq-observer.package", "schema_version": 3,
        "repository": repository, "variant": "guided", "repo": os.fspath(repo),
        "assembled_at": utc_now(), "integrity_status": "failed",
        "audit_unit": {
            "kind": "accountable_session", "repository": repository,
            "role": role, "session_path": os.fspath(session_path),
            "retirement_id": retirement_id, "whole_session": True,
        },
        "sessions": [], "warnings": [reason], "unknown_entries": [],
    }
    package_path = run_dir / "package.json"
    if not os.path.lexists(package_path):
        atomic_append(package_path, canonical_json_bytes(package))
    else:
        existing = json_document(
            read_regular(package_path, "observer package"), "observer package",
        )
        if (
            not isinstance(existing, dict)
            or existing.get("schema") != "qq-observer.package"
            or existing.get("schema_version") != 3
            or existing.get("audit_unit", {}).get("kind") != "accountable_session"
            or existing.get("audit_unit", {}).get("repository") != repository
            or existing.get("audit_unit", {}).get("role") != role
            or existing.get("audit_unit", {}).get("session_path") != os.fspath(session_path)
        ):
            fail(f"append-only conflict at {package_path}", 65)
    record_observer_failure(run_dir, reason, version=2)
    print(f"qq-observe: accountable-session observation failed: {reason}", file=sys.stderr)
    raise SystemExit(65)


def validate_retirement_receipt(path, role, session_path):
    raw = read_regular(path, "retirement receipt")
    receipt = json_document(raw, "retirement receipt")
    expected = {
        "schema", "schema_version", "retirement_id", "role", "session", "state",
        "retired_at", "whole_session", "compaction_count", "succession_ready",
        "retirement_boundary", "pane_closure_independent",
    }
    if not isinstance(receipt, dict) or set(receipt) != expected:
        raise ValueError("retirement receipt has a malformed or range-selecting shape")
    retirement_id = receipt.get("retirement_id")
    if (
        receipt.get("schema") != "qq-accountable-session.retirement"
        or receipt.get("schema_version") != 1
        or not isinstance(retirement_id, str)
        or not SAFE_COMPONENT.fullmatch(retirement_id)
        or retirement_id in (".", "..")
        or receipt.get("role") != role
        or not isinstance(receipt.get("session"), str)
        or not os.path.isabs(receipt["session"])
        or Path(os.path.realpath(receipt["session"])) != session_path
        or receipt.get("state") != "retired"
        or receipt.get("whole_session") is not True
        or isinstance(receipt.get("compaction_count"), bool)
        or not isinstance(receipt.get("compaction_count"), int)
        or receipt["compaction_count"] not in (0, 1)
        or receipt.get("succession_ready") is not True
        or receipt.get("retirement_boundary") != {
            "architect": "alignment_transaction_drained",
            "coordinator": "atomic_swap_complete",
        }[role]
        or receipt.get("pane_closure_independent") is not True
    ):
        raise ValueError("retirement receipt does not prove one verified whole-session retirement")
    if not isinstance(receipt.get("retired_at"), str):
        raise ValueError("retirement receipt lacks retired_at")
    try:
        time_value(receipt["retired_at"])
    except ValueError as error:
        raise ValueError(f"retirement receipt retired_at {error}") from error
    return receipt


def observer_dispatch_runtime():
    value = os.environ.get("QQ_DISPATCH_RUNTIME_ROOT")
    if value is None:
        state_home = os.environ.get("XDG_STATE_HOME")
        if state_home is None:
            home = os.environ.get("HOME")
            if not home:
                fail("HOME is required when XDG_STATE_HOME is unset", 65)
            state_home = os.path.join(home, ".local", "state")
        value = os.path.join(state_home, "qq", "delegate")
    if not os.path.isabs(value):
        fail("dispatch runtime root must be absolute", 65)
    root = Path(os.path.realpath(value))
    ensure_directory(root)
    return root.resolve(strict=True)


def retirement_brief(run_dir, session_path):
    return f"""# Accountable-session Observer work order

Analyze only the accountable-session audit package at `{run_dir}` under
`delegation/manifests/observer-procedure.md`. The package binds the frozen
whole Pi transcript at `{session_path}` by canonical path, byte count, and
SHA-256; it contains no transcript copy and permits no selected range.

Derive facts and signals from that source, emit `qq-observer.analysis` v2 with
all four required lenses, and finalize through:

`qq-observe finalize --run {run_dir} --analysis <temporary-analysis.json>`

On any package, binding, evidence, or semantic failure, preserve reproducible
mechanical facts and finalize the run through:

`qq-observe finalize --run {run_dir} --failed <specific-reason>`

Analysis is asynchronous. Succession and pane closure are external and must
not be awaited or changed. Write only the final result to this delegate run's
`ENVELOPE.md` following `delegation/manifests/ENVELOPE.md`.
"""


def retire_session(values):
    options = parse_flags(values, {"--role", "--session", "--repo", "--retirement"})
    if set(options) != {"--role", "--session", "--repo", "--retirement"}:
        fail("retire-session requires --role, --session, --repo, and --retirement")
    role = options["--role"]
    if role not in ACCOUNTABLE_ROLES:
        fail("--role must be architect or coordinator")
    if not os.path.isabs(options["--session"]):
        fail("--session must be an absolute path")
    session_path = Path(os.path.realpath(options["--session"]))
    repo, _ = git_root(options["--repo"])
    repository = canonical_repository(repo)
    runs_root = observer_runs_root(create=True)
    receipt_path_value = options["--retirement"]
    retirement_id = "unverified"
    try:
        if not os.path.isabs(receipt_path_value):
            raise ValueError("--retirement must be an absolute path")
        receipt_path = Path(receipt_path_value).resolve(strict=True)
        receipt = validate_retirement_receipt(receipt_path, role, session_path)
        retirement_id = receipt["retirement_id"]
        if not regular_file(Path(options["--session"])):
            raise ValueError("accountable session is missing, linked, or not a regular file")
        source_raw = read_regular(session_path, "accountable session")
        entries = accountable_session_document(source_raw, "accountable session")
        compactions = sum(
            isinstance(entry, dict) and entry.get("type") == "compaction"
            for entry in entries
        )
        if compactions != receipt["compaction_count"]:
            raise ValueError(
                "retirement receipt contradicts the transcript compaction count"
            )
    except SystemExit:
        retirement_package_failure(
            runs_root, repository, repo, role, session_path, retirement_id,
            "retirement receipt or accountable session is missing or malformed",
        )
    except (OSError, RuntimeError, ValueError) as error:
        retirement_package_failure(
            runs_root, repository, repo, role, session_path, retirement_id, str(error),
        )

    source_sha256 = hashlib.sha256(source_raw).hexdigest()
    source_size = len(source_raw)
    run_dir = accountable_run_dir(
        runs_root, repository, role, session_path, create_root=True,
    )
    ensure_directory(run_dir, runs_root)
    package = {
        "schema": "qq-observer.package", "schema_version": 3,
        "repository": repository, "variant": "guided", "repo": os.fspath(repo),
        "assembled_at": utc_now(), "integrity_status": "bound",
        "audit_unit": {
            "kind": "accountable_session", "repository": repository,
            "role": role, "session_path": os.fspath(session_path),
            "retirement_id": receipt["retirement_id"],
            "retired_at": receipt["retired_at"], "whole_session": True,
            "compaction_count": receipt["compaction_count"],
            "retirement_boundary": receipt["retirement_boundary"],
        },
        "sessions": [{
            "label": "accountable-session", "source_path": os.fspath(session_path),
            "role": "accountable", "evidence": "verified-retirement-whole-session",
            "storage": "external-bound", "sha256": source_sha256,
            "size_bytes": source_size, "entries": len(entries),
        }],
        "warnings": [], "unknown_entries": [],
    }
    package_path = run_dir / "package.json"
    if os.path.lexists(package_path):
        existing = json_document(
            read_regular(package_path, "observer package"), "observer package",
        )
        comparable = dict(package)
        comparable.pop("assembled_at")
        existing_comparable = dict(existing) if isinstance(existing, dict) else {}
        existing_comparable.pop("assembled_at", None)
        if existing_comparable != comparable:
            fail(f"conflicting duplicate retirement trigger at {package_path}", 65)
    else:
        atomic_append(package_path, canonical_json_bytes(package))

    if os.path.lexists(run_dir / "analysis.json"):
        emit({"status": "completed", "run_dir": os.fspath(run_dir)})
    if os.path.lexists(run_dir / "analysis_failed.json"):
        emit({"status": "failed", "run_dir": os.fspath(run_dir)})

    runtime = observer_dispatch_runtime()
    dispatch_dir = runtime / f"observer-{accountable_run_token(repository, role, session_path)}"
    ensure_directory(dispatch_dir, runtime)
    brief_path = dispatch_dir / "BRIEF.md"
    brief_data = retirement_brief(run_dir, session_path).encode()
    atomic_append(brief_path, brief_data)
    terminal_path = dispatch_dir / "TERMINAL"
    if os.path.lexists(terminal_path):
        reason = "Observer delegate terminated before finalizing accountable-session analysis"
        if not regular_file(terminal_path):
            reason = "Observer delegate left an invalid terminal record"
        record_observer_failure(run_dir, reason, version=2)
        fail(reason, 65)
    launch_path = dispatch_dir / "LAUNCH"
    if os.path.lexists(launch_path):
        if not regular_file(launch_path):
            reason = "Observer delegate left an invalid launch record"
            record_observer_failure(run_dir, reason, version=2)
            fail(reason, 65)
        emit({
            "status": "started", "run_dir": os.fspath(run_dir),
            "dispatch_run_dir": os.fspath(dispatch_dir), "duplicate": True,
        })

    process = run_process([
        delegate_binary, "start", "--role", "observer", "--cwd", os.fspath(repo),
        "--brief", os.fspath(brief_path),
    ], "asynchronous Observer dispatch", cwd=repo)
    if process.returncode != 0:
        detail = process.stderr.decode("utf-8", "replace").strip()
        reason = f"asynchronous Observer dispatch failed{': ' + detail if detail else ''}"
        record_observer_failure(run_dir, reason, version=2)
        fail(reason, 65)
    try:
        receipt_out = json.loads(
            process.stdout.decode("utf-8"),
            parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)),
        )
    except (UnicodeDecodeError, ValueError, RecursionError):
        reason = "asynchronous Observer dispatch returned invalid JSON"
        record_observer_failure(run_dir, reason, version=2)
        fail(reason, 65)
    if (
        not isinstance(receipt_out, dict)
        or receipt_out.get("schema") != "qq-run-start"
        or receipt_out.get("version") != 1
        or receipt_out.get("state") != "accepted"
        or receipt_out.get("run_dir") != os.fspath(dispatch_dir)
    ):
        reason = "asynchronous Observer dispatch returned a malformed acceptance receipt"
        record_observer_failure(run_dir, reason, version=2)
        fail(reason, 65)
    emit({
        "status": "started", "run_dir": os.fspath(run_dir),
        "dispatch_run_dir": os.fspath(dispatch_dir),
        "dispatch_run_id": receipt_out.get("run_id"), "duplicate": False,
    })


def session_status(values):
    options = parse_flags(values, {"--role", "--session", "--repository"})
    if set(options) != {"--role", "--session", "--repository"}:
        fail("session-status requires --role, --session, and --repository")
    role = options["--role"]
    if role not in ACCOUNTABLE_ROLES:
        fail("--role must be architect or coordinator")
    session_value = options["--session"]
    if not os.path.isabs(session_value):
        fail("--session must be an absolute path")
    repository = options["--repository"]
    parts = repository.split("/")
    if len(parts) != 2 or any(
        not part or part in (".", "..") or not SAFE_COMPONENT.fullmatch(part)
        for part in parts
    ):
        fail("--repository must be a safe OWNER/REPO identity")
    session_path = Path(os.path.realpath(session_value))
    run_dir = accountable_run_dir(
        observer_runs_root(create=False), repository, role, session_path,
    )
    state = "missing"
    reason = "observer package is absent"
    if regular_file(run_dir / "package.json"):
        state, reason = "started", "analysis is not finalized"
        try:
            package = json_document(
                read_regular(run_dir / "package.json", "observer package"),
                "observer package",
            )
            issue = accountable_binding_issue(package)
        except SystemExit:
            issue = "package or transcript binding is invalid"
        except (OSError, RuntimeError, ValueError) as error:
            issue = f"package or transcript binding is invalid: {error}"
        if issue:
            state, reason = "failed", issue
        elif os.path.lexists(run_dir / "analysis.json") and os.path.lexists(run_dir / "analysis_failed.json"):
            state, reason = "failed", "observer run has contradictory terminal records"
        elif regular_file(run_dir / "analysis.json"):
            state, reason = "completed", "analysis finalized"
        elif os.path.lexists(run_dir / "analysis_failed.json"):
            failure_reason = canonical_analysis_failure_reason(run_dir / "analysis_failed.json")
            state, reason = "failed", failure_reason or "analysis failure record is invalid"
    emit({
        "state": state, "reason": reason, "repository": repository, "role": role,
        "session": os.fspath(session_path), "run_dir": os.fspath(run_dir),
    }, 0 if state != "missing" else 1)


def canonical_analysis_failure_reason(path):
    if not regular_file(path):
        return None
    raw = read_regular(path, "finalized failed analysis")
    try:
        item = json.loads(
            raw.decode("utf-8"),
            parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)),
        )
    except (UnicodeDecodeError, ValueError, RecursionError):
        return None
    if (
        not isinstance(item, dict)
        or set(item) != {"schema", "schema_version", "status", "reason"}
        or item.get("schema") != "qq-observer.analysis"
        or isinstance(item.get("schema_version"), bool)
        or item.get("schema_version") not in (1, 2)
        or item.get("status") != "analysis_failed"
        or not isinstance(item.get("reason"), str)
        or not item["reason"]
        or raw != canonical_json_bytes(item)
    ):
        return None
    return item["reason"]


def minimal_analysis_v2(item):
    required = {
        "schema", "schema_version", "audit_unit", "run", "lenses", "entity_audit",
        "fidelity", "skill_conformity", "episodes", "dropped_signals", "limitations",
    }
    if set(item) not in (required, required | {"taxonomy_exception"}):
        fail("analysis schema violation: v2 success analysis has the wrong fields")
    audit = item.get("audit_unit")
    if not isinstance(audit, dict) or audit.get("kind") not in (
        "delivered_change", "accountable_session",
    ):
        fail("analysis schema violation: audit_unit has the wrong shape")
    run = item.get("run")
    if (
        not isinstance(run, dict)
        or not isinstance(run.get("id"), str) or not run["id"]
        or not isinstance(run.get("sessions"), list) or not run["sessions"]
        or not all(isinstance(value, str) and value for value in run["sessions"])
    ):
        fail("analysis schema violation: run has the wrong shape")
    lenses = item.get("lenses")
    if (
        not isinstance(lenses, list) or len(lenses) != 4
        or [row.get("name") for row in lenses if isinstance(row, dict)] != list(LENS_NAMES)
        or any(row.get("status") not in ("clear", "finding", "unverifiable") for row in lenses)
    ):
        fail("analysis schema violation: four ordered lenses are required")
    episodes = item.get("episodes")
    if not isinstance(episodes, list):
        fail("analysis schema violation: episodes must be an array")
    for index, episode in enumerate(episodes):
        if not isinstance(episode, dict) or episode.get("primary_lens") not in LENS_NAMES:
            fail(f"analysis schema violation: episodes[{index}] lacks one primary lens")
        if not isinstance(episode.get("recurrence_key"), str) or not episode["recurrence_key"]:
            fail(f"analysis schema violation: episodes[{index}] lacks recurrence_key")
    if "taxonomy_exception" in item:
        exception = item["taxonomy_exception"]
        if not isinstance(exception, dict) or not isinstance(exception.get("recurrence_key"), str):
            fail("analysis schema violation: taxonomy_exception has the wrong shape")
    if not isinstance(item.get("dropped_signals"), list):
        fail("analysis schema violation: dropped_signals must be an array")
    if not isinstance(item.get("limitations"), str):
        fail("analysis schema violation: limitations must be a string")
    return item


def minimal_analysis(item):
    if not isinstance(item, dict):
        fail("analysis schema violation: top level must be an object")
    if item.get("status") == "analysis_failed":
        if (
            item.get("schema") == "qq-observer.analysis"
            and item.get("schema_version") in (1, 2)
            and set(item) == {"schema", "schema_version", "status", "reason"}
            and isinstance(item.get("reason"), str)
        ):
            fail("rendering requires a successful analysis")
    if (
        item.get("schema") != "qq-observer.analysis"
        or isinstance(item.get("schema_version"), bool)
        or item.get("schema_version") not in (1, 2)
    ):
        fail("analysis schema violation: unsupported schema or schema_version")
    if item.get("schema_version") == 2:
        return minimal_analysis_v2(item)
    if item.get("status") == "analysis_failed":
        fail("rendering requires a successful analysis")
    if not isinstance(item.get("run"), dict):
        fail("analysis schema violation: run must be an object")
    if not isinstance(item["run"].get("change"), str) or not item["run"]["change"]:
        fail("analysis schema violation: run.change must be a non-empty string")
    sessions = item["run"].get("sessions")
    if not isinstance(sessions, list) or not sessions or not all(isinstance(value, str) for value in sessions):
        fail("analysis schema violation: run.sessions must be a non-empty string array")
    episodes = item.get("episodes")
    if not isinstance(episodes, list):
        fail("analysis schema violation: episodes must be an array")
    episode_fields = {
        "kind": str, "title": str, "sessions": list, "evidence": list,
        "what_happened": str, "root_cause": str, "root_cause_location": str,
        "cost": dict, "remedy": dict, "confidence": str,
        "confidence_why": str, "recurrence_key": str,
    }
    for index, episode in enumerate(episodes):
        if not isinstance(episode, dict):
            fail(f"analysis schema violation: episodes[{index}] must be an object")
        for field, expected in episode_fields.items():
            if not isinstance(episode.get(field), expected):
                fail(f"analysis schema violation: episodes[{index}].{field} has the wrong shape")
        if (
            not episode["sessions"]
            or not all(isinstance(value, str) for value in episode["sessions"])
            or not episode["evidence"]
        ):
            fail(f"analysis schema violation: episodes[{index}] session/evidence shape is invalid")
        if "rank" in episode and (
            isinstance(episode["rank"], bool) or not isinstance(episode["rank"], int)
        ):
            fail(f"analysis schema violation: episodes[{index}].rank must be an integer")
        if "no_signal" in episode and not isinstance(episode["no_signal"], bool):
            fail(f"analysis schema violation: episodes[{index}].no_signal must be a boolean")
        for citation in episode["evidence"]:
            if (
                not isinstance(citation, dict)
                or not isinstance(citation.get("session"), str)
                or not isinstance(citation.get("entries"), list)
                or not all(isinstance(value, int) and not isinstance(value, bool)
                           for value in citation["entries"])
                or not isinstance(citation.get("quote"), str)
            ):
                fail(f"analysis schema violation: episodes[{index}].evidence has the wrong shape")
            # The one-entry evidence rule is enforced only where new analyses are
            # accepted (validate-analysis and, through it, finalize). Historical
            # finalized analyses predate the rule and stay valid immutable evidence.
        cost = episode["cost"]
        if (
            not all(field in cost for field in ("turns", "tokens", "duration_ms", "source"))
            or not all(
                isinstance(cost[field], int) and not isinstance(cost[field], bool)
                for field in ("turns", "tokens", "duration_ms")
            )
            or not isinstance(cost["source"], str)
        ):
            fail(f"analysis schema violation: episodes[{index}].cost has the wrong shape")
        remedy = episode["remedy"]
        if not isinstance(remedy.get("type"), str) or not isinstance(remedy.get("smallest_change"), str):
            fail(f"analysis schema violation: episodes[{index}].remedy has the wrong shape")
    dropped = item.get("dropped_signals")
    if not isinstance(dropped, list):
        fail("analysis schema violation: dropped_signals must be an array")
    for signal in dropped:
        if (
            not isinstance(signal, dict)
            or not isinstance(signal.get("kind"), str)
            or not isinstance(signal.get("entries"), list)
            or not signal["entries"]
            or not all(
                isinstance(value, int) and not isinstance(value, bool)
                for value in signal["entries"]
            )
            or not isinstance(signal.get("why"), str)
        ):
            fail("analysis schema violation: dropped_signals item has the wrong shape")
    if not isinstance(item.get("limitations"), str):
        fail("analysis schema violation: limitations must be a string")
    return item


def observer_run_directories():
    runs_root = observer_runs_root(create=False)
    if not runs_root.exists():
        return []
    try:
        root_info = os.lstat(runs_root)
    except OSError as error:
        fail(f"cannot inspect observer runs root: {error}", 65)
    if not stat.S_ISDIR(root_info.st_mode):
        fail("observer runs root is not a directory", 65)
    pattern = re.compile(
        r"(?:^pr-[1-9][0-9]*$)|(?:^session-(?:architect|coordinator)-[0-9a-f]{32}$)"
    )
    run_dirs = []

    def real_directory(path, label):
        try:
            info = os.lstat(path)
        except OSError as error:
            fail(f"cannot inspect {label} {path}: {error}", 65)
        if not stat.S_ISDIR(info.st_mode):
            fail(f"{label} is not a real directory: {path}", 65)

    qualified = runs_root / "by-repository"
    if os.path.lexists(qualified):
        real_directory(qualified, "qualified observer root")
        for owner in sorted(qualified.iterdir(), key=lambda path: path.name):
            if not SAFE_COMPONENT.fullmatch(owner.name) or owner.name in (".", ".."):
                fail(f"unsafe qualified Repository owner: {owner}", 65)
            real_directory(owner, "qualified Repository owner")
            for repository in sorted(owner.iterdir(), key=lambda path: path.name):
                if not SAFE_COMPONENT.fullmatch(repository.name) or repository.name in (".", ".."):
                    fail(f"unsafe qualified Repository name: {repository}", 65)
                real_directory(repository, "qualified Repository")
                for candidate in sorted(repository.iterdir(), key=lambda path: path.name):
                    if not pattern.fullmatch(candidate.name):
                        continue
                    real_directory(candidate, "qualified observer run")
                    run_dirs.append(candidate)
    return run_dirs


def accountable_binding_issue(package):
    if not isinstance(package, dict):
        return "observer package is not an object"
    audit = package.get("audit_unit")
    if not isinstance(audit, dict) or audit.get("kind") != "accountable_session":
        return None
    if package.get("integrity_status") != "bound":
        return "accountable-session package integrity did not bind"
    sessions = package.get("sessions")
    if not isinstance(sessions, list) or len(sessions) != 1:
        return "accountable-session package does not name exactly one whole session"
    row = sessions[0]
    if (
        not isinstance(row, dict)
        or row.get("storage") != "external-bound"
        or row.get("evidence") != "verified-retirement-whole-session"
        or not isinstance(row.get("source_path"), str)
        or not os.path.isabs(row["source_path"])
        or Path(os.path.realpath(row["source_path"])) != Path(audit.get("session_path", ""))
        or not isinstance(row.get("sha256"), str)
        or re.fullmatch(r"[0-9a-f]{64}", row["sha256"]) is None
        or isinstance(row.get("size_bytes"), bool)
        or not isinstance(row.get("size_bytes"), int)
        or row["size_bytes"] < 0
        or row["size_bytes"] > ACCOUNTABLE_SESSION_CAP
    ):
        return "accountable-session package binding has the wrong shape"
    path = Path(row["source_path"])
    if not regular_file(path):
        return "bound accountable session is missing or not a regular file"
    try:
        raw = read_regular(path, "bound accountable session")
        entries = accountable_session_document(raw, "bound accountable session")
    except (SystemExit, ValueError) as error:
        return f"bound accountable session is invalid: {error}"
    if len(raw) != row["size_bytes"]:
        return "bound accountable session byte count changed"
    if hashlib.sha256(raw).hexdigest() != row["sha256"]:
        return "bound accountable session SHA-256 changed"
    if row.get("entries") != len(entries):
        return "bound accountable session entry count changed"
    return None


def package_metadata(run_dir, require_timestamp=False):
    package = json_document(
        read_regular(run_dir / "package.json", "observer package"),
        "observer package",
    )
    if not isinstance(package, dict) or package.get("schema") != "qq-observer.package":
        fail("observer package has the wrong shape", 65)
    version = package.get("schema_version")
    timestamp = package.get("assembled_at")
    repo = package.get("repo")
    if package.get("variant", "guided") != "guided":
        fail("observer package has an invalid variant", 65)
    if not isinstance(repo, str) or not os.path.isabs(repo):
        fail("observer package lacks its absolute local Repository root", 65)
    if require_timestamp:
        if not isinstance(timestamp, str):
            fail("observer package lacks assembled_at", 65)
        parse_time(timestamp, "observer package assembled_at")
    if version not in (2, 3):
        fail("observer package has an unsupported schema_version", 65)
    repository = package.get("repository")
    if not isinstance(repository, str):
        fail("Repository-qualified package lacks repository", 65)
    parts = repository.split("/")
    if len(parts) != 2 or any(
        not part or part in (".", "..") or not SAFE_COMPONENT.fullmatch(part)
        for part in parts
    ):
        fail("observer package has an invalid GitHub Repository identity", 65)

    audit = package.get("audit_unit") if version == 3 else None
    if version == 2:
        pr = package.get("pr")
        audit = {
            "kind": "delivered_change", "repository": repository, "pr": pr,
            "branch": package.get("branch"), "merge_commit": package.get("merge_commit"),
            "merged_at": package.get("merged_at"),
        }
    if not isinstance(audit, dict) or audit.get("repository") != repository:
        fail("observer package lacks a valid audit_unit", 65)
    kind = audit.get("kind")
    pr = audit.get("pr") if kind == "delivered_change" else None
    if kind == "delivered_change":
        if isinstance(pr, bool) or not isinstance(pr, int) or pr <= 0:
            fail("delivered-Change package lacks a positive PR number", 65)
        expected = repository_run_dir(observer_runs_root(create=False), repository, pr)
    elif kind == "accountable_session":
        role = audit.get("role")
        session_path = audit.get("session_path")
        if role not in ACCOUNTABLE_ROLES or not isinstance(session_path, str) or not os.path.isabs(session_path):
            fail("accountable-session package has an invalid identity", 65)
        expected = accountable_run_dir(
            observer_runs_root(create=False), repository, role, session_path,
        )
    else:
        fail("observer package audit_unit kind is invalid", 65)
    if Path(os.path.realpath(run_dir)) != Path(os.path.realpath(expected)):
        fail(f"Repository-qualified package is stored under the wrong identity: {run_dir}", 65)
    return {
        "package": package, "repository": repository, "repo": repo,
        "pr": pr, "variant": "guided", "timestamp": timestamp, "legacy": False,
        "audit_unit": audit,
    }


def canonical_json_bytes(value):
    return (json.dumps(value, separators=(",", ":"), sort_keys=True) + "\n").encode()


def sha256_file(path, label):
    return hashlib.sha256(read_regular(path, label)).hexdigest()


ARCHITECT_CONTEXT_SCHEMA = "qq-observer.architect-context"
ARCHITECT_FINDING_LIMIT = 50
ARCHITECT_HEALTH_LIMIT = 20
ARCHITECT_HEALTH_REASON_LIMIT = 500
ARCHITECT_CONTEXT_BYTE_LIMIT = 131072
CONFIDENCE_WEIGHT = {"high": 3, "medium": 2, "low": 1}
DISPOSITIONS_TITLE = "Observer dispositions"
DISPOSITIONS_PREAMBLE = """# Observer dispositions

The operator-settled dispositions of Observer Architect findings. Append
only through `backlog doc update --content` with the complete body
(qq-observe owns the append; never hand-edit). Coverage of a recurrence
key = a settled entry here, or an exact-substring hit for the key in a
Backlog decision record (Task, plan, and doc mentions never settle).

## Entries"""


def display_text(value, nonempty=False):
    return (
        isinstance(value, str)
        and (not nonempty or bool(value.strip()))
        and len(value) <= 20000
        and not any(ord(character) < 32 and character not in "\n\t" or ord(character) == 127 for character in value)
    )


def qq_repository_root():
    root = Path(self_path).resolve().parent.parent
    if not root.is_dir():
        fail("qq Observer source root is unavailable", 65)
    return root


def parse_dispositions_body(body, path):
    label = f"Observer dispositions document {path}"
    if body == f"{DISPOSITIONS_PREAMBLE}\n\n(none yet)":
        return []
    prefix = f"{DISPOSITIONS_PREAMBLE}\n\n"
    if not body.startswith(prefix):
        fail(f"{label} has a malformed complete body", 65)
    entries = []
    keys = set()
    for line in body[len(prefix):].splitlines():
        try:
            entry = json.loads(line)
        except ValueError:
            fail(f"{label} has a malformed disposition entry line", 65)
        if not isinstance(entry, dict) or sorted(entry) != [
            "action", "note", "occurrence_ids", "recurrence_key", "scope", "settled_at",
        ]:
            fail(f"{label} has a malformed disposition entry", 65)
        key = entry["recurrence_key"]
        occurrence_ids = entry["occurrence_ids"]
        if (
            not display_text(key, nonempty=True) or "\n" in key
            or key in keys
            or entry["action"] not in ("route", "set_aside")
            or not display_text(entry["scope"]) or "\n" in entry["scope"]
            or not display_text(entry["note"]) or "\n" in entry["note"]
            or not isinstance(occurrence_ids, list) or not occurrence_ids
            or any(
                not isinstance(value, str)
                or re.fullmatch(r"occurrence-[0-9a-f]{32}", value) is None
                for value in occurrence_ids
            )
            or occurrence_ids != sorted(occurrence_ids)
            or len(occurrence_ids) != len(set(occurrence_ids))
            or (entry["action"] == "route" and not entry["scope"].strip())
            or (entry["action"] == "set_aside" and entry["scope"] != "")
        ):
            fail(f"{label} violates the disposition contract", 65)
        if not isinstance(entry["settled_at"], str):
            fail(f"{label} has a malformed settlement timestamp", 65)
        try:
            time_value(entry["settled_at"])
        except ValueError:
            fail(f"{label} has a malformed settlement timestamp", 65)
        keys.add(key)
        entries.append(entry)
    return entries


def render_dispositions_body(entries):
    if not entries:
        return f"{DISPOSITIONS_PREAMBLE}\n\n(none yet)"
    lines = [
        json.dumps(entry, separators=(",", ":"), sort_keys=True)
        for entry in entries
    ]
    return f"{DISPOSITIONS_PREAMBLE}\n\n" + "\n".join(lines)


def load_dispositions(required=False):
    docs_root = qq_repository_root() / "backlog" / "docs"
    if not os.path.lexists(docs_root):
        if required:
            fail("Observer dispositions document is absent", 65)
        return None
    try:
        info = os.lstat(docs_root)
    except OSError as error:
        fail(f"cannot inspect Backlog documents directory: {error}", 65)
    if not stat.S_ISDIR(info.st_mode):
        fail("Backlog documents path is not a directory", 65)
    matches = []
    try:
        candidates = sorted(docs_root.rglob("*.md"), key=lambda path: os.fspath(path))
    except OSError as error:
        fail(f"cannot scan Backlog documents: {error}", 65)
    for candidate in candidates:
        if not regular_file(candidate):
            fail(f"Backlog document is not a regular file: {candidate}", 65)
        try:
            raw_text = read_regular(candidate, "Backlog document").decode("utf-8")
        except UnicodeDecodeError as error:
            fail(f"Backlog document is not UTF-8: {error}", 65)
        lines = raw_text.splitlines()
        if not lines or lines[0] != "---":
            if "Observer-dispositions" in candidate.name:
                fail("Observer dispositions document lacks frontmatter", 65)
            continue
        try:
            frontmatter_end = lines.index("---", 1)
        except ValueError:
            if "Observer-dispositions" in candidate.name:
                fail("Observer dispositions document has unclosed frontmatter", 65)
            continue
        titles = []
        for line in lines[1:frontmatter_end]:
            match = re.fullmatch(r"title:[ \t]*(.*)", line)
            if match is not None:
                titles.append(match.group(1).strip("'\""))
        if DISPOSITIONS_TITLE in titles:
            if titles != [DISPOSITIONS_TITLE]:
                fail("Observer dispositions document has malformed title frontmatter", 65)
            fields, body = backlog_frontmatter(candidate, "Observer dispositions document")
            matches.append((candidate, fields, body))
    if not matches:
        if required:
            fail("Observer dispositions document is absent", 65)
        return None
    if len(matches) != 1:
        fail(f"Observer dispositions title matched {len(matches)} documents", 65)
    path, fields, body = matches[0]
    doc_id = fields.get("id")
    if not isinstance(doc_id, str) or re.fullmatch(r"doc-[0-9]+", doc_id) is None:
        fail("Observer dispositions document has no canonical document id", 65)
    entries = parse_dispositions_body(body, path)
    return {"id": doc_id, "path": path, "body": body, "entries": entries}


def update_dispositions(document, entries):
    body = render_dispositions_body(entries)
    process = run_process(
        [backlog_binary, "doc", "update", document["id"], "--content", body],
        "Backlog Observer dispositions update", cwd=qq_repository_root(),
    )
    if process.returncode != 0:
        detail = process.stderr.decode("utf-8", "replace").strip()
        fail(f"Backlog Observer dispositions update failed{': ' + detail if detail else ''}", 65)
    updated = load_dispositions(required=True)
    if updated["id"] != document["id"] or updated["entries"] != entries or updated["body"] != body:
        fail("Backlog Observer dispositions update did not persist the complete body", 65)


def decision_record_texts():
    decisions_root = qq_repository_root() / "backlog" / "decisions"
    if not os.path.lexists(decisions_root):
        fail("Backlog decisions directory is absent", 65)
    try:
        info = os.lstat(decisions_root)
    except OSError as error:
        fail(f"cannot inspect Backlog decisions directory: {error}", 65)
    if not stat.S_ISDIR(info.st_mode):
        fail("Backlog decisions path is not a directory", 65)
    try:
        candidates = sorted(decisions_root.rglob("*.md"), key=lambda path: os.fspath(path))
    except OSError as error:
        fail(f"cannot scan Backlog decision records: {error}", 65)
    texts = []
    for candidate in candidates:
        if not regular_file(candidate):
            fail(f"Backlog decision record is not a regular file: {candidate}", 65)
        try:
            texts.append(read_regular(candidate, "Backlog decision record").decode("utf-8"))
        except UnicodeDecodeError as error:
            fail(f"Backlog decision record is not UTF-8: {error}", 65)
    return texts


def coverage_by_key(keys, dispositions=None):
    if dispositions is None:
        dispositions = load_dispositions(required=False)
    settled = {
        entry["recurrence_key"] for entry in (dispositions or {}).get("entries", [])
    }
    unique = sorted(set(keys))
    for key in unique:
        if not display_text(key, nonempty=True) or "\n" in key:
            fail("Observer recurrence key is unsafe for coverage matching", 65)
    # Coverage is one exact-substring pass over the local decision records:
    # a settled disposition entry or a verbatim key hit in a decision file.
    pending = [key for key in unique if key not in settled]
    covered = {key: True for key in unique if key in settled}
    if pending:
        corpus = decision_record_texts()
        for key in pending:
            covered[key] = any(key in text for text in corpus)
    return covered


def recurrence_keys(values):
    if values:
        fail("recurrence-keys takes no arguments", 64)
    dispositions = load_dispositions(required=False)
    settled = {
        entry["recurrence_key"] for entry in (dispositions or {}).get("entries", [])
    }
    for key in sorted({
        row["recurrence_key"] for row in all_architect_occurrences()
    } - settled):
        print(key)


def architect_round_identity(run_dir, identity):
    source = {
        "run_dir": os.fspath(run_dir), "repo": identity["repo"],
        "repository": identity["repository"], "legacy": identity["legacy"],
        "pr": identity["pr"], "variant": identity["variant"],
        "assembled_at": identity["timestamp"],
    }
    # Preserve historical v2 source bytes/occurrence identities. Only new v3
    # packages add the explicit audit-unit discriminator.
    if identity["package"].get("schema_version") == 3:
        source["audit_unit"] = identity["audit_unit"]
    return source


def occurrence_episode(episode, position):
    return episode if "rank" in episode else {**episode, "rank": position}


def occurrence_identity(source, package_sha256, analysis_sha256, episode):
    immutable = {
        "source": source, "package_sha256": package_sha256, "analysis_sha256": analysis_sha256,
        "rank": episode["rank"], "recurrence_key": episode["recurrence_key"],
    }
    return "occurrence-" + hashlib.sha256(canonical_json_bytes(immutable)).hexdigest()[:32]


def all_architect_occurrences():
    occurrences = []
    for run_dir in observer_run_directories():
        identity = package_metadata(run_dir, require_timestamp=True)
        if identity["audit_unit"]["kind"] == "accountable_session" \
            and accountable_binding_issue(identity["package"]) is not None:
            continue
        if identity["variant"] != "guided" or not regular_file(run_dir / "analysis.json"):
            continue
        analysis_raw = read_regular(run_dir / "analysis.json", "Architect source analysis")
        analysis = minimal_analysis(json_document(analysis_raw, "Architect source analysis"))
        analysis_sha256 = hashlib.sha256(analysis_raw).hexdigest()
        package_sha256 = sha256_file(run_dir / "package.json", "Architect source package")
        source = architect_round_identity(run_dir, identity)
        source_findings = list(analysis["episodes"])
        if analysis.get("schema_version") == 2 and "taxonomy_exception" in analysis:
            exception = dict(analysis["taxonomy_exception"])
            exception.setdefault("title", "Taxonomy exception")
            exception.setdefault("kind", "taxonomy-exception")
            exception.setdefault("confidence", "low")
            exception.setdefault("remedy", {"smallest_change": "Reopen the four-lens contract."})
            source_findings.append(exception)
        for position, source_episode in enumerate(source_findings, 1):
            episode = occurrence_episode(source_episode, position)
            occurrence_id = occurrence_identity(source, package_sha256, analysis_sha256, episode)
            occurrences.append({
                "occurrence_id": occurrence_id,
                "recurrence_key": episode["recurrence_key"],
                "source": source,
                "package_sha256": package_sha256, "analysis_sha256": analysis_sha256,
                "episode": episode,
            })
    occurrences.sort(key=lambda row: (
        row["recurrence_key"], row["source"]["assembled_at"],
        row["source"]["repository"] or row["source"]["repo"],
        row["source"]["pr"] or 0, row["occurrence_id"],
    ))
    identities = [row["occurrence_id"] for row in occurrences]
    if len(identities) != len(set(identities)):
        fail("Observer Architect occurrence identity collision", 65)
    return occurrences



def slim_architect_occurrence(occurrence):
    source = occurrence["source"]
    slim_source = {
        name: source[name] for name in (
            "run_dir", "repository", "legacy", "pr", "variant", "assembled_at",
        )
    }
    if "audit_unit" in source:
        slim_source["audit_unit"] = source["audit_unit"]
    return {
        "occurrence_id": occurrence["occurrence_id"],
        "recurrence_key": occurrence["recurrence_key"],
        "source": slim_source,
    }


def bounded_architect_health_reason(reason):
    if not display_text(reason, nonempty=True):
        return "analysis failure reason is unsafe to display; inspect analysis_failed.json", True
    if len(reason) > ARCHITECT_HEALTH_REASON_LIMIT:
        return reason[:ARCHITECT_HEALTH_REASON_LIMIT], True
    return reason, False


def architect_health_state():
    rows = []
    for run_dir in observer_run_directories():
        identity = package_metadata(run_dir, require_timestamp=True)
        package = identity["package"]
        audit = identity["audit_unit"]
        session_unit = audit["kind"] == "accountable_session"
        analysis_path = run_dir / "analysis.json"
        failure_path = run_dir / "analysis_failed.json"
        analysis_present = os.path.lexists(analysis_path)
        failure_present = os.path.lexists(failure_path)
        terminal_issue = (
            "observer run has contradictory terminal analysis records"
            if analysis_present and failure_present else None
        )
        if terminal_issue is not None and not session_unit:
            fail(f"{terminal_issue}: {run_dir}", 65)

        status = "started" if session_unit else "pending"
        reason = "analysis is not finalized"
        reason_truncated = False
        binding_issue = terminal_issue or (
            accountable_binding_issue(package) if session_unit else None
        )
        failure_reason = canonical_analysis_failure_reason(failure_path)
        if binding_issue is not None:
            status = "failed" if session_unit else "analysis_failed"
            reason, reason_truncated = bounded_architect_health_reason(binding_issue)
        elif failure_reason is not None:
            status = "failed" if session_unit else "analysis_failed"
            reason, reason_truncated = bounded_architect_health_reason(failure_reason)
        elif failure_present:
            status = "failed" if session_unit else "analysis_failed"
            reason = "analysis failure record is invalid; inspect analysis_failed.json"
            reason_truncated = True
        elif regular_file(analysis_path):
            if not session_unit:
                continue
            status = "completed"
            reason = "analysis finalized"

        rows.append({
            "status": status,
            "repository": identity["repository"],
            "pr": identity["pr"],
            "audit_unit": audit,
            "run_dir": os.fspath(run_dir),
            "assembled_at": identity["timestamp"],
            "reason": reason,
            "reason_truncated": reason_truncated,
        })
    rows.sort(key=lambda row: (
        -time_value(row["assembled_at"]).timestamp(), row["repository"],
        row["pr"] or 0, row["run_dir"],
    ))
    return {
        "rounds": rows[:ARCHITECT_HEALTH_LIMIT],
        "omitted_rounds": max(0, len(rows) - ARCHITECT_HEALTH_LIMIT),
    }


def architect_context_state(dispositions=None):
    if dispositions is None:
        dispositions = load_dispositions(required=False)
    occurrences = all_architect_occurrences()
    observer_health = architect_health_state()
    coverage = coverage_by_key((row["recurrence_key"] for row in occurrences), dispositions)
    uncovered = [
        row for row in occurrences if not coverage[row["recurrence_key"]]
    ]
    by_key = {}
    for occurrence in uncovered:
        by_key.setdefault(occurrence["recurrence_key"], []).append(occurrence)
    ranked = []
    for key, rows in by_key.items():
        latest = max(rows, key=lambda row: (time_value(row["source"]["assembled_at"]), row["occurrence_id"]))
        episode = latest["episode"]
        ranked.append((
            (-len(rows), -time_value(latest["source"]["assembled_at"]).timestamp(),
             -CONFIDENCE_WEIGHT[episode["confidence"]], key),
            {
                "recurrence_key": key, "title": episode["title"], "kind": episode["kind"],
                "confidence": episode["confidence"], "covered": False,
                "suggested_scope": episode["remedy"]["smallest_change"],
                "occurrences": [slim_architect_occurrence(row) for row in rows],
            },
        ))
    ranked.sort(key=lambda item: item[0])
    findings = []
    for _, finding in ranked[:ARCHITECT_FINDING_LIMIT]:
        candidate = {
            "schema": ARCHITECT_CONTEXT_SCHEMA, "schema_version": 5,
            "findings": findings + [finding],
            "observer_health": observer_health,
            "omitted_findings": len(ranked) - len(findings) - 1,
        }
        if len(canonical_json_bytes(candidate)) > ARCHITECT_CONTEXT_BYTE_LIMIT:
            break
        findings.append(finding)
    document = {
        "schema": ARCHITECT_CONTEXT_SCHEMA, "schema_version": 5,
        "findings": findings,
        "observer_health": observer_health,
        "omitted_findings": len(ranked) - len(findings),
    }
    if len(canonical_json_bytes(document)) > ARCHITECT_CONTEXT_BYTE_LIMIT:
        fail("Observer Architect pending context exceeds its model working-set limit", 65)
    displayed_ids = {
        row["occurrence_id"] for finding in findings for row in finding["occurrences"]
    }
    return document, {
        row["occurrence_id"]: row for row in occurrences
        if row["occurrence_id"] in displayed_ids
    }


def architect_context(values):
    if values:
        fail(f"invalid or incomplete option: {values[0]}")
    emit(architect_context_state()[0])


def disposition_settle(values):
    options = parse_flags(values, {"--decisions"})
    if set(options) != {"--decisions"}:
        fail("disposition-settle requires --decisions")
    path = canonical_existing(options["--decisions"], "settlement decisions input")
    decisions = json_document(
        read_regular(path, "settlement decisions input"), "settlement decisions input",
    )
    if not isinstance(decisions, list) or not 1 <= len(decisions) <= 50:
        fail("settlement decisions must be an array of 1..50 decisions", 65)
    seen = set()
    for decision in decisions:
        if not isinstance(decision, dict) or sorted(decision) != ["action", "note", "recurrence_key", "scope"]:
            fail("settlement decision has a malformed shape", 65)
        key = decision["recurrence_key"]
        if (
            not display_text(key, nonempty=True) or "\n" in key
            or decision["action"] not in ("route", "set_aside")
            or not display_text(decision["scope"]) or "\n" in decision["scope"]
            or not display_text(decision["note"]) or "\n" in decision["note"]
            or (decision["action"] == "route" and not decision["scope"].strip())
            or (decision["action"] == "set_aside" and decision["scope"] != "")
        ):
            fail("settlement decision violates the disposition contract", 65)
        if key in seen:
            fail(f"settlement decision duplicates recurrence key: {key}", 65)
        seen.add(key)
    dispositions = load_dispositions(required=True)
    settled_keys = {entry["recurrence_key"] for entry in dispositions["entries"]}
    live_ids = {}
    for row in all_architect_occurrences():
        if row["recurrence_key"] not in settled_keys:
            live_ids.setdefault(row["recurrence_key"], []).append(row["occurrence_id"])
    settled_at = utc_now()
    entries = list(dispositions["entries"])
    for decision in decisions:
        key = decision["recurrence_key"]
        occurrence_ids = sorted(live_ids.get(key, []))
        if not occurrence_ids:
            fail(f"settlement decision has no unresolved occurrences: {key}", 65)
        entries.append({
            "action": decision["action"], "note": decision["note"],
            "occurrence_ids": occurrence_ids, "recurrence_key": key,
            "scope": decision["scope"], "settled_at": settled_at,
        })
    update_dispositions(dispositions, entries)
    emit({"status": "settled", "settled": [decision["recurrence_key"] for decision in decisions]})


def run_finalized(values):
    options = parse_flags(values, {"--pr", "--repository"})
    if set(options) != {"--pr", "--repository"}:
        fail("run-finalized requires --pr and --repository")
    pr_value = options["--pr"]
    if not isinstance(pr_value, str) or re.fullmatch(r"[1-9][0-9]*", pr_value) is None:
        fail("--pr must be a positive integer", 65)
    pr = int(pr_value)
    repository = options["--repository"]
    parts = repository.split("/") if isinstance(repository, str) else []
    if len(parts) != 2 or any(
        not part or part in (".", "..") or not SAFE_COMPONENT.fullmatch(part)
        for part in parts
    ):
        fail("--repository must be a safe OWNER/REPO identity", 65)
    run_dir = repository_run_dir(observer_runs_root(create=False), repository, pr)
    finalized = False
    reason = "missing-or-invalid"
    if regular_file(run_dir / "package.json"):
        package = json_document(
            read_regular(run_dir / "package.json", "observer package"),
            "observer package",
        )
        if (
            isinstance(package, dict)
            and package.get("schema") == "qq-observer.package"
            and package.get("schema_version") in (2, 3)
            and package.get("variant", "guided") == "guided"
            and package.get("pr") == pr
            and package.get("repository") == repository
        ):
            if os.path.lexists(run_dir / "analysis.json") \
                and os.path.lexists(run_dir / "analysis_failed.json"):
                fail(f"observer run has both terminal analysis records: {run_dir}", 65)
            if regular_file(run_dir / "analysis.json"):
                finalized, reason = True, "finalized"
            elif canonical_analysis_failure_reason(run_dir / "analysis_failed.json") is not None:
                finalized, reason = True, "finalized-failed"
            else:
                reason = "analysis-not-finalized"
    emit({
        "pr": pr, "repository": repository,
        "run_dir": os.fspath(run_dir), "finalized": finalized, "reason": reason,
    }, 0 if finalized else 1)


def backlog_frontmatter(path, label):
    try:
        text = read_regular(path, label).decode("utf-8")
    except UnicodeDecodeError as error:
        fail(f"{label} is not UTF-8: {error}", 65)
    lines = text.splitlines()
    if not lines or lines[0] != "---":
        fail(f"{label} lacks frontmatter", 65)
    try:
        end = lines.index("---", 1)
    except ValueError:
        fail(f"{label} has unclosed frontmatter", 65)
    fields = {}
    index = 1
    while index < end:
        line = lines[index]
        match = re.fullmatch(r"([A-Za-z_][A-Za-z0-9_]*):(?:[ \t]*(.*))?", line)
        if not match:
            index += 1
            continue
        key, raw = match.group(1), match.group(2) or ""
        if key in fields:
            fail(f"{label} duplicates frontmatter field {key}", 65)
        if raw == "":
            values, item_indent = [], math.inf
            index += 1
            while index < end and (lines[index].startswith(" ") or lines[index] == ""):
                child = lines[index].strip()
                if child:
                    indent = len(lines[index]) - len(lines[index].lstrip())
                    item = re.fullmatch(r"-[ \t]+(.+)", child)
                    if item:
                        item_indent = indent
                        values.append(item.group(1).strip("'\\\""))
                    elif indent <= item_indent:
                        fail(f"{label} has malformed frontmatter list", 65)
                    else:
                        values[-1] += f" {child}"
                index += 1
            fields[key] = values
            continue
        fields[key] = raw.strip("'\\\"")
        index += 1
    return fields, "\n".join(lines[end + 1:])


def markdown_inline(value):
    return str(value).replace("\\", "\\\\").replace("|", "\\|").replace("\n", " ")


def compact_value(value):
    return json.dumps(value, separators=(",", ":"), sort_keys=True)


def render_bytes(run_dir, analysis=None):
    package = json_document(read_regular(run_dir / "package.json", "observer package"), "observer package")
    if not isinstance(package, dict) or not isinstance(package.get("sessions"), list):
        fail("observer package has the wrong shape")
    if analysis is None:
        analysis = json_document(read_regular(run_dir / "analysis.json", "analysis JSON"), "analysis JSON")
    analysis = minimal_analysis(analysis)
    session_rows = packaged_session_paths(run_dir, package)
    labels = [label for label, _ in sorted(session_rows)]
    if not labels:
        fail("observer package contains no sessions")
    source_paths = dict(session_rows)
    scratch, derived = derive_session_facts(run_dir, labels, source_paths)
    facts_rows = []
    for label in labels:
        path = derived[label]
        facts = json_document(read_regular(path, "facts JSON"), f"facts JSON {path}")
        required = {
            "entries": int, "turns_by_role": dict, "token_usage": dict,
            "tool_calls": dict, "tool_errors": dict, "wall_clock": dict,
            "unknown_entries": dict,
        }
        if (
            not isinstance(facts, dict)
            or facts.get("schema") != "qq-observe.facts"
            or facts.get("schema_version") != 2
            or any(not isinstance(facts.get(field), expected) for field, expected in required.items())
            or not isinstance(facts["tool_calls"].get("total"), int)
            or not isinstance(facts["tool_errors"].get("total"), int)
            or not isinstance(facts["wall_clock"].get("duration_ms"), int)
            or not isinstance(facts["unknown_entries"].get("total"), int)
        ):
            fail(f"facts JSON has the wrong shape: {path}")
        facts_rows.append((label, facts))

    pr = package.get("pr")
    generated = package.get("assembled_at")
    audit = package.get("audit_unit", {})
    if not isinstance(generated, str):
        fail("observer package lacks assembled_at")
    if audit.get("kind") == "accountable_session":
        heading = (
            "# qq observer analysis — "
            f"{audit.get('role', 'accountable')} session {audit.get('retirement_id', '')}"
        )
    elif isinstance(pr, int) and not isinstance(pr, bool):
        heading = f"# qq observer analysis — PR #{pr}"
    else:
        fail("delivered-Change observer package lacks pr")
    lines = [
        heading, "",
        f"- Generated at: `{generated}`",
        f"- Audit unit: `{analysis['run'].get('id', analysis['run'].get('change'))}`",
        "- Sessions:",
    ]
    for session in analysis["run"]["sessions"]:
        lines.append(f"  - `{session}`")
    if analysis.get("schema_version") == 2:
        lines.extend(["", "## Four lenses", ""])
        for lens in analysis["lenses"]:
            lines.append(f"- **{lens['name']}** — `{lens['status']}`: {lens['summary']}")
    lines.extend([
        "", "## Session facts", "",
        "| Session | Entries | Turns by role | Token usage | Tool calls | Tool errors | Duration ms | Unknown entries |",
        "| --- | ---: | --- | --- | ---: | ---: | ---: | ---: |",
    ])
    for label, facts in facts_rows:
        lines.append(
            f"| {markdown_inline(label)} | {facts['entries']} | "
            f"`{markdown_inline(compact_value(facts['turns_by_role']))}` | "
            f"`{markdown_inline(compact_value(facts['token_usage']))}` | "
            f"{facts['tool_calls']['total']} | {facts['tool_errors']['total']} | "
            f"{facts['wall_clock']['duration_ms']} | {facts['unknown_entries']['total']} |"
        )
    lines.extend(["", "## Episodes", ""])
    ordered = sorted(
        enumerate(analysis["episodes"]),
        key=lambda pair: (pair[1].get("rank", pair[0] + 1), pair[0]),
    )
    if not ordered:
        lines.append("No episodes retained.")
        lines.append("")
    for position, (_, episode) in enumerate(ordered, 1):
        rank = episode.get("rank", position)
        lines.extend([
            f"### {rank}. {episode['title']}", "",
            f"- Kind: `{episode['kind']}`",
            *([f"- Primary lens: `{episode['primary_lens']}`"] if "primary_lens" in episode else []),
            "- Sessions: " + ", ".join(f"`{value}`" for value in episode["sessions"]),
            f"- Confidence: `{episode['confidence']}` — {episode['confidence_why']}",
            f"- Recurrence key: `{episode['recurrence_key']}`", "",
            "#### Evidence", "",
        ])
        for citation in episode["evidence"]:
            entries = ", ".join(str(value) for value in citation["entries"])
            lines.extend([
                f"- Session `{citation['session']}`, entries {entries}",
                f"  > {citation['quote'].replace(chr(10), chr(10) + '  > ')}",
            ])
        cost = episode["cost"]
        remedy = episode["remedy"]
        lines.extend([
            "", "#### What happened", "", episode["what_happened"],
            "", "#### Root cause", "", episode["root_cause"],
            "", f"Location: `{episode['root_cause_location']}`",
            "", "#### Cost", "",
            f"- Turns: {cost['turns']}", f"- Tokens: {cost['tokens']}",
            f"- Duration ms: {cost['duration_ms']}", f"- Source: `{cost['source']}`",
            "", "#### Remedy", "", f"- Type: `{remedy['type']}`",
            f"- Smallest change: {remedy['smallest_change']}", "",
        ])
    lines.extend(["## Dropped signals", ""])
    if analysis["dropped_signals"]:
        for signal in analysis["dropped_signals"]:
            entries = ", ".join(str(value) for value in signal["entries"])
            lines.append(f"- `{signal['kind']}` (entries {entries}): {signal['why']}")
    else:
        lines.append("None.")
    lines.extend(["", "## Limitations", "", analysis["limitations"], ""])
    return "\n".join(lines).encode("utf-8")


def run_directory(value):
    if not isinstance(value, str) or not os.path.isabs(value):
        fail("run directory must be an absolute path", 65)
    runs_root = observer_runs_root(create=False)
    try:
        runs_root = runs_root.resolve(strict=True)
    except (OSError, RuntimeError, ValueError) as error:
        fail(f"cannot resolve observer runs root: {error}", 65)
    requested = Path(os.path.abspath(value))
    if not within(requested, runs_root):
        fail(f"run directory is outside observer runs root: {requested}", 65)
    current = runs_root
    for part in requested.relative_to(runs_root).parts:
        current = current / part
        try:
            info = os.lstat(current)
        except OSError as error:
            fail(f"cannot inspect run directory component {current}: {error}", 65)
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            fail(f"run directory component is not a real directory: {current}", 65)
    run_dir = canonical_directory(value, "run directory")
    if not within(run_dir, runs_root):
        fail(f"run directory is outside observer runs root: {run_dir}", 65)
    return run_dir


def packaged_session_paths(run_dir, package):
    rows = package.get("sessions") if isinstance(package, dict) else None
    if not isinstance(rows, list):
        fail("observer package has the wrong session shape", 65)
    if package.get("audit_unit", {}).get("kind") == "accountable_session":
        issue = accountable_binding_issue(package)
        if issue is not None:
            fail(issue, 65)
    sessions = []
    labels = set()
    for row in rows:
        if not isinstance(row, dict):
            fail("observer package session has the wrong shape", 65)
        label = row.get("label")
        if (
            not isinstance(label, str) or not SAFE_COMPONENT.fullmatch(label)
            or label in labels
        ):
            fail("observer package session has an unsafe or duplicate label", 65)
        labels.add(label)
        if row.get("storage") == "external-bound":
            source = row.get("source_path")
            if not isinstance(source, str) or not os.path.isabs(source):
                fail("external-bound session lacks its canonical source", 65)
            session = Path(source)
        else:
            session = run_dir / "sessions" / f"{label}.jsonl"
        if not regular_file(session):
            fail(f"observer package session inputs are incomplete: {label}", 65)
        sessions.append((label, session))
    return sessions


def derive_session_facts(run_dir, labels, source_paths=None):
    """Derive facts for packaged sessions into a scratch directory.

    Facts are derivable-on-read views of the packaged transcripts; the run
    dir stores only the transcripts they recompute from. Returns the
    scratch directory (the caller keeps it alive) and a {label: path} map.
    """
    scratch = tempfile.TemporaryDirectory(prefix="qq-observe-facts-")
    derived = {}
    for label in labels:
        session = (
            source_paths[label] if source_paths is not None
            else run_dir / "sessions" / f"{label}.jsonl"
        )
        process = run_process(
            [self_path, "facts", os.fspath(session)], "qq-observe facts",
        )
        if process.returncode != 0:
            detail = process.stderr.decode("utf-8", "replace").strip()
            scratch.cleanup()
            fail(
                f"qq-observe facts failed for session {label} in run {run_dir}"
                f"{': ' + detail if detail else ''}",
                65,
            )
        try:
            json.loads(
                process.stdout.decode("utf-8"),
                parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)),
            )
        except (UnicodeDecodeError, ValueError, RecursionError) as error:
            scratch.cleanup()
            fail(
                f"qq-observe facts emitted invalid JSON for session {label} "
                f"in run {run_dir}: {error}",
                65,
            )
        fact = Path(scratch.name) / f"{label}.json"
        fact.write_bytes(process.stdout)
        derived[label] = fact
    return scratch, derived


def validated_package_analysis(run_dir, analysis_path):
    package = json_document(
        read_regular(run_dir / "package.json", "observer package"),
        "observer package",
    )
    if not isinstance(package, dict) or not isinstance(package.get("sessions"), list):
        fail("observer package has the wrong shape", 65)
    repo_value = package.get("repo")
    if not isinstance(repo_value, str):
        fail("observer package lacks its Repository root", 65)
    repo = canonical_directory(repo_value, "package Repository root")
    sessions = packaged_session_paths(run_dir, package)
    if not sessions:
        fail("observer package contains no sessions", 65)

    # Facts are derived lazily at validation time; the package stores only
    # the transcripts they recompute from.
    validation = [self_path, "validate-analysis", os.fspath(analysis_path)]
    validation.extend(os.fspath(session) for _, session in sessions)
    scratch, derived = derive_session_facts(
        run_dir, [label for label, _ in sessions], dict(sessions),
    )
    for label, session in sessions:
        validation.extend(("--facts", f"{session}={derived[label]}"))
    process = run_process(validation, "analysis validation", cwd=repo)
    if process.returncode != 0:
        reason = "validator refused the analysis"
        try:
            failure = json.loads(process.stdout.decode("utf-8"))
            if (
                isinstance(failure, dict)
                and failure.get("status") == "analysis_failed"
                and isinstance(failure.get("reason"), str)
            ):
                reason = failure["reason"]
        except (UnicodeDecodeError, ValueError, RecursionError):
            detail = process.stderr.decode("utf-8", "replace").strip()
            if detail:
                reason = detail
        fail(
            f"analysis validation failed: {reason}; record the run with --failed instead",
            65,
        )
    ranked = json_document(process.stdout, "validated analysis output")
    if isinstance(ranked, dict) and ranked.get("status") == "analysis_failed":
        fail("successful finalization requires findings; use --failed instead", 65)
    if not isinstance(ranked, dict) or ranked.get("schema_version") != 2:
        fail("newly finalized analysis must use the four-lens v2 contract", 65)
    ranked = minimal_analysis(ranked)
    package_audit = package.get("audit_unit")
    if package.get("schema_version") == 2:
        package_audit = {
            "kind": "delivered_change", "repository": package.get("repository"),
            "pr": package.get("pr"), "branch": package.get("branch"),
            "merge_commit": package.get("merge_commit"), "merged_at": package.get("merged_at"),
        }
    if ranked.get("audit_unit") != package_audit:
        fail("analysis audit_unit does not match the immutable observer package", 65)
    if "taxonomy_exception" in ranked:
        recurrence_key = ranked["taxonomy_exception"]["recurrence_key"]
        previous = {
            row["recurrence_key"] for row in all_architect_occurrences()
            if row["source"]["run_dir"] != os.fspath(run_dir)
        }
        if recurrence_key in previous:
            fail(
                "taxonomy_exception recurrence reopens the four-lens contract; "
                "it cannot be finalized as another exception",
                65,
            )
    return (
        json.dumps(ranked, separators=(",", ":"), sort_keys=True) + "\n"
    ).encode()


def finalize(values):
    options = parse_flags(values, {"--run", "--analysis", "--failed"})
    if "--run" not in options:
        fail("finalize requires --run")
    if ("--analysis" in options) == ("--failed" in options):
        fail("finalize requires exactly one of --analysis or --failed")
    run_dir = run_directory(options["--run"])
    read_regular(run_dir / "package.json", "observer package")
    writes = []
    if "--analysis" in options:
        source = canonical_existing(options["--analysis"], "temporary analysis input")
        if within(source, run_dir):
            fail(
                "--analysis must name a temporary child/runtime input outside the Observer run; "
                "qq-observe finalize is the sole writer of the run's analysis.json",
                65,
            )
        raw = validated_package_analysis(run_dir, source)
        analysis = json_document(raw, "validated analysis output")
        if os.path.lexists(run_dir / "analysis_failed.json"):
            fail("run already contains analysis_failed.json", 65)
        writes.append((run_dir / "analysis.json", raw))
        markdown = render_bytes(run_dir, analysis=analysis)
        writes.append((run_dir / "analysis.md", markdown))
    else:
        reason = options["--failed"]
        if not reason:
            fail("--failed requires a non-empty reason")
        if os.path.lexists(run_dir / "analysis.json"):
            fail("run already contains analysis.json", 65)
        package = json_document(
            read_regular(run_dir / "package.json", "observer package"),
            "observer package",
        )
        failure = {
            "schema": "qq-observer.analysis",
            "schema_version": 2 if package.get("schema_version") == 3 else 1,
            "status": "analysis_failed", "reason": reason,
        }
        writes.append((
            run_dir / "analysis_failed.json",
            (json.dumps(failure, separators=(",", ":"), sort_keys=True) + "\n").encode(),
        ))
    for path, data in writes:
        preflight_append(path, data)
    changed = []
    for path, data in writes:
        if atomic_append(path, data):
            changed.append(path.name)
    emit({"status": "finalized", "run_dir": os.fspath(run_dir), "written": changed})


if command == "assemble":
    assemble(args)
elif command == "retire-session":
    retire_session(args)
elif command == "session-status":
    session_status(args)
