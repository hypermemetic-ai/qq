from collections import Counter
import datetime as dt
import json
import math
import os
from pathlib import Path
import re
import sys

command, *args = sys.argv[1:]
# Tunable deterministic heuristics from the 2026-07-23/24 operator notes.
REASONING_VOLUME_CHARS = 20000
REASONING_CONTORTION_MESSAGES = 3
REASONING_CONTORTION_CHARS = 5000
STALL_GAP_ENTRIES = 40
OPERATOR_REQUEST_TOOL_NAME_IDIOMS = (
    re.compile(r"^operator_stage$", re.IGNORECASE),
    re.compile(r"^(?:operator_request|request_operator)$", re.IGNORECASE),
)
OPERATOR_REQUEST_ARGUMENT_IDIOMS = (
    re.compile(r"\bherdr\s+notification\s+show\b", re.IGNORECASE),
    re.compile(r'"(?:operator_directed|operatorDirected)":true', re.IGNORECASE),
    re.compile(r'"(?:recipient|target)":"operator"', re.IGNORECASE),
)
HERDR_NOTIFICATION_TOOL_NAME_IDIOMS = (
    re.compile(r"(?:^|[_-])notification(?:$|[_-])", re.IGNORECASE),
)
HERDR_TOOL_NAME_IDIOMS = (
    re.compile(r"^herdr$", re.IGNORECASE),
)
NOTIFICATION_ARGUMENT_IDIOMS = (
    re.compile(r"\bnotification\b", re.IGNORECASE),
)
NOTIFICATION_SHOW_ARGUMENT_IDIOMS = (
    re.compile(r"\bshow\b", re.IGNORECASE),
)
MUTATING_TOOL_NAMES = ("edit", "write")
COMMIT_SHAPED_COMMAND_IDIOMS = (
    re.compile(
        r'(?:^|[;&|"]\s*)git(?:\s+[^;&|\s]+){0,12}\s+commit\b',
        re.IGNORECASE,
    ),
)
CHECK_SHAPED_COMMAND_IDIOMS = (
    re.compile(r"tests/", re.IGNORECASE),
    re.compile(r"\bratchet\b", re.IGNORECASE),
    re.compile(r"\bshell-tests\b", re.IGNORECASE),
    re.compile(r"\bgh\s+pr\s+checks\b", re.IGNORECASE),
)
COMPLETION_CLAIM_IDIOMS = re.compile(
    r"\b(?:checks?\s+pass(?:ed)?|green|ready\s+to\s+merge|"
    r"all\s+tests?\s+pass(?:ed)?|done\s+and\s+verified)\b",
    re.IGNORECASE,
)
ANALYSIS_KINDS = {
    "tool-gap.capability-unknown", "tool-gap.tool-missing", "instruction-conflict",
    "instruction-deficiency", "tool-misuse", "friction", "waste", "failure",
    "substrate", "design-question", "operator-seam.unconfirmed-assumption",
    "operator-seam.unseen-request", "operator-seam.misread-direction",
    "operator-seam.misleading-claim", "operator-seam.stale-world",
    "operator-seam.cross-session", "operator-seam.abandonment",
