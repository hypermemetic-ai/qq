#!/usr/bin/env bash
set -euo pipefail

STATE_HOME="${XDG_STATE_HOME:-${HOME:?HOME is required}/.local/state}"
OUTPUT_ROOT="${QQ_OPENWIKI_OUTPUT_ROOT:-$STATE_HOME/qq/openwiki}"

if (( $# != 2 )); then
  echo "usage: qq-openwiki-publish REPOSITORY_KEY GENERATED_DIRECTORY" >&2
  exit 2
fi
key="$1"
generated="$2"
if [[ ! "$key" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]; then
  echo "OpenWiki repository key is malformed: $key" >&2
  exit 1
fi
if [[ ! -d "$generated" || -L "$generated" ]]; then
  echo "Generated OpenWiki output is not a directory: $generated" >&2
  exit 1
fi
if find "$generated" -mindepth 1 ! -type d ! -type f -print -quit | grep -q .; then
  echo "Generated OpenWiki output contains a non-file entry." >&2
  exit 1
fi

store="$OUTPUT_ROOT/$key"
releases="$store/releases"
mkdir -p -- "$releases"
chmod 0755 -- "$OUTPUT_ROOT" "$store" "$releases"
exec 9>"$store/publish.lock"
flock 9

incoming="$(mktemp -d "$releases/.incoming.XXXXXX")"
next=""
cleanup() {
  if [[ -n "$incoming" && -d "$incoming" ]]; then
    chmod -R u+w -- "$incoming" 2>/dev/null || true
    rm -rf -- "$incoming"
  fi
  if [[ -n "$next" ]]; then rm -f -- "$next"; fi
}
trap cleanup EXIT
cp -a -- "$generated/." "$incoming/"
find "$incoming" -type f -exec chmod 0444 {} +
find "$incoming" -type d -exec chmod 0555 {} +

if [[ -L "$store/current" && -d "$store/current" ]] \
  && diff -qr -- "$store/current" "$incoming" >/dev/null; then
  echo "OpenWiki is already current."
  exit 0
fi

release="$(date -u +%Y%m%dT%H%M%S)-${incoming##*.incoming.}"
release_path="$releases/$release"
mv -T -- "$incoming" "$release_path"
incoming=""
next="$store/.current.$$.$RANDOM"
ln -s -- "releases/$release" "$next"
mv -Tf -- "$next" "$store/current"
next=""
trap - EXIT
printf 'Published OpenWiki release %s for %s.\n' "$release" "$key"
