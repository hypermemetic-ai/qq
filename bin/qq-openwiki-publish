#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
MAIN_ROOT="${QQ_OPENWIKI_MAIN_ROOT:-$ROOT}"
MAIN_BRANCH="${QQ_OPENWIKI_MAIN_BRANCH:-main}"
PUBLISHED_REPO_KEY="${QQ_OPENWIKI_PUBLISHED_REPO_KEY:-qq}"
BRANCH="openwiki"

if (( $# != 2 )); then
  echo "usage: qq-openwiki-publish REPOSITORY_KEY GENERATED_DIRECTORY" >&2
  exit 2
fi
key="$1"
generated="$2"
if [[ ! "$key" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]; then
  echo "OpenWiki repository key is malformed: $key" >&2
  exit 1
fi
if [[ "$key" != "$PUBLISHED_REPO_KEY" ]]; then
  echo "OpenWiki branch publication is enabled only for $PUBLISHED_REPO_KEY, not $key." >&2
  exit 1
fi
if [[ ! -d "$generated" || -L "$generated" ]]; then
  echo "Generated OpenWiki output is not a directory: $generated" >&2
  exit 1
fi
if find "$generated" -mindepth 1 ! -type d ! -type f -print -quit | grep -q .; then
  echo "Generated OpenWiki output contains a non-file entry." >&2
  exit 1
fi

MAIN_ROOT="$(git -C "$MAIN_ROOT" rev-parse --show-toplevel)"
COMMON_DIR="$(git -C "$MAIN_ROOT" rev-parse --path-format=absolute --git-common-dir)"
exec 9>"$COMMON_DIR/qq-openwiki-publish.lock"
flock 9

index="$(mktemp "$COMMON_DIR/qq-openwiki-index.XXXXXX")"
cleanup() { rm -f -- "$index"; }
trap cleanup EXIT
rm -f -- "$index"
GIT_INDEX_FILE="$index" git -C "$MAIN_ROOT" --work-tree="$generated" read-tree --empty
GIT_INDEX_FILE="$index" git -C "$MAIN_ROOT" --work-tree="$generated" add -f -A -- .
tree="$(GIT_INDEX_FILE="$index" git -C "$MAIN_ROOT" write-tree)"

branch_ref="refs/heads/$BRANCH"
parent=""
if git -C "$MAIN_ROOT" show-ref --verify --quiet "$branch_ref"; then
  parent="$(git -C "$MAIN_ROOT" rev-parse "$branch_ref")"
elif git -C "$MAIN_ROOT" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
  parent="$(git -C "$MAIN_ROOT" rev-parse "refs/remotes/origin/$BRANCH")"
  git -C "$MAIN_ROOT" update-ref "$branch_ref" "$parent"
fi
if [[ -n "$parent" ]] && git -C "$MAIN_ROOT" merge-base "$parent" "refs/heads/$MAIN_BRANCH" >/dev/null 2>&1; then
  echo "OpenWiki publication branch is not orphaned from main." >&2
  exit 1
fi

changed=true
if [[ -n "$parent" && "$(git -C "$MAIN_ROOT" rev-parse "$parent^{tree}")" == "$tree" ]]; then
  changed=false
else
  if [[ -n "$parent" ]]; then
    commit="$(printf 'Refresh OpenWiki\n' | git -C "$MAIN_ROOT" commit-tree "$tree" -p "$parent")"
    git -C "$MAIN_ROOT" update-ref "$branch_ref" "$commit" "$parent"
  else
    commit="$(printf 'Publish OpenWiki\n' | git -C "$MAIN_ROOT" commit-tree "$tree")"
    git -C "$MAIN_ROOT" update-ref "$branch_ref" "$commit"
  fi
fi

if git -C "$MAIN_ROOT" remote get-url origin >/dev/null 2>&1; then
  git -C "$MAIN_ROOT" push --quiet origin "$branch_ref:$branch_ref"
fi

if [[ "$changed" == true ]]; then
  printf 'Published OpenWiki commit %s for %s.\n' "$(git -C "$MAIN_ROOT" rev-parse "$branch_ref")" "$key"
else
  echo "OpenWiki is already current."
fi
