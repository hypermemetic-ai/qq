#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
MAIN_ROOT="${QQ_OPENWIKI_MAIN_ROOT:-$ROOT}"
MAIN_BRANCH="${QQ_OPENWIKI_MAIN_BRANCH:-main}"
STATE_HOME="${XDG_STATE_HOME:-${HOME:?HOME is required}/.local/state}"
OUTPUT_ROOT="${QQ_OPENWIKI_OUTPUT_ROOT:-$STATE_HOME/qq/openwiki}"
PUBLISHED_REPO_KEY="${QQ_OPENWIKI_PUBLISHED_REPO_KEY:-qq}"
OPENWIKI_BIN="${QQ_OPENWIKI_BIN:-openwiki}"
SHELL_ENV_PRELOAD="${QQ_OPENWIKI_SHELL_ENV_PRELOAD:-$ROOT/bin/qq-openwiki-shell-env.cjs}"
PUBLISH_BIN="${QQ_OPENWIKI_PUBLISH_BIN:-$ROOT/bin/qq-openwiki-publish}"
PROMPT="${QQ_OPENWIKI_PROMPT:-Keep this wiki short and practical.}"
ACTION="${QQ_OPENWIKI_ACTION:-auto}"

MAIN_ROOT="$(git -C "$MAIN_ROOT" rev-parse --show-toplevel)"
REPO_KEY="${QQ_OPENWIKI_REPO_KEY:-$(basename -- "$MAIN_ROOT")}"
if [[ ! "$REPO_KEY" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]; then
  echo "OpenWiki repository key is malformed: $REPO_KEY" >&2
  exit 1
fi
if [[ "$REPO_KEY" != "$PUBLISHED_REPO_KEY" ]]; then
  echo "OpenWiki publication is enabled only for $PUBLISHED_REPO_KEY, not $REPO_KEY." >&2
  exit 1
fi
case "$ACTION" in auto|init|update) ;; *) echo "OpenWiki action must be auto, init, or update." >&2; exit 1 ;; esac

current_branch="$(git -C "$MAIN_ROOT" symbolic-ref --quiet --short HEAD)"
if [[ "$current_branch" != "$MAIN_BRANCH" ]]; then
  echo "OpenWiki source checkout is on $current_branch, not $MAIN_BRANCH." >&2
  exit 1
fi

store="$OUTPUT_ROOT/$REPO_KEY"
current="$store/current"
if [[ ! -L "$MAIN_ROOT/openwiki" || "$(readlink -- "$MAIN_ROOT/openwiki")" != "$current" ]]; then
  echo "OpenWiki locator does not point to the canonical publication: $current" >&2
  exit 1
fi

mkdir -p -- "$store"
chmod 0755 -- "$OUTPUT_ROOT" "$store"
exec 9>"$store/refresh.lock"
if ! flock -n 9; then
  echo "OpenWiki refresh is already running."
  exit 0
fi

work="$(mktemp -d "$store/.refresh.XXXXXX")"
project="$work/project"
registered_worktree() {
  git -C "$MAIN_ROOT" worktree list --porcelain | grep -Fqx "worktree $project"
}
cleanup() {
  if [[ -d "$work" ]]; then chmod -R u+w -- "$work" 2>/dev/null || true; fi
  if registered_worktree; then
    if ! git -C "$MAIN_ROOT" worktree remove --force -- "$project" >/dev/null 2>&1; then
      rm -rf -- "$project"
      git -C "$MAIN_ROOT" worktree prune >/dev/null 2>&1 || true
    fi
  fi
  rm -rf -- "$work"
}
trap cleanup EXIT
git -C "$MAIN_ROOT" worktree add --quiet --detach "$project" HEAD
git -C "$project" update-index --skip-worktree openwiki
rm -f -- "$project/openwiki"
git_excludes="$work/openwiki.exclude"
printf '/openwiki/\n' >"$git_excludes"

has_current=false
if [[ -L "$current" && -d "$current" ]]; then
  cp -aL -- "$current" "$project/openwiki"
  find "$project/openwiki" -type d -exec chmod u+rwx {} +
  find "$project/openwiki" -type f -exec chmod u+rw {} +
  has_current=true
fi
if [[ "$ACTION" == auto ]]; then
  if [[ "$has_current" == true && -f "$project/openwiki/.last-update.json" ]]; then
    ACTION=update
  else
    ACTION=init
  fi
fi
if [[ "$ACTION" == update && "$has_current" == false ]]; then
  echo "OpenWiki cannot update before the canonical publication is seeded." >&2
  exit 1
fi
if [[ "$ACTION" == init && -e "$project/openwiki" ]]; then
  rm -rf -- "$project/openwiki"
fi

node_options="${NODE_OPTIONS:-}"
if [[ -n "$node_options" ]]; then node_options+=" "; fi
node_options+="--require=$SHELL_ENV_PRELOAD"
(
  cd -- "$project"
  GIT_CONFIG_COUNT=1 \
  GIT_CONFIG_KEY_0=core.excludesFile \
  GIT_CONFIG_VALUE_0="$git_excludes" \
  NODE_OPTIONS="$node_options" \
    "$OPENWIKI_BIN" code "--$ACTION" --print "$PROMPT"
)
if [[ ! -d "$project/openwiki" || -L "$project/openwiki" ]]; then
  echo "OpenWiki did not produce a regular output directory." >&2
  exit 1
fi
"$PUBLISH_BIN" "$REPO_KEY" "$project/openwiki"
