#!/usr/bin/env bash
set -euo pipefail

if [[ ${QQ_RELAY_INSTALL_ROOT+x} ]]; then
  if [[ -z "$QQ_RELAY_INSTALL_ROOT" || "$QQ_RELAY_INSTALL_ROOT" != /* ]]; then
    printf 'qq-relay: QQ_RELAY_INSTALL_ROOT must be an absolute path\n' >&2
    exit 64
  fi
  install_root=$QQ_RELAY_INSTALL_ROOT
else
  if [[ -z ${HOME:-} || "$HOME" != /* ]]; then
    printf 'qq-relay: HOME must be an absolute path when QQ_RELAY_INSTALL_ROOT is unset\n' >&2
    exit 64
  fi
  install_root=$HOME/.local/lib/qq/relay
fi
relay_bin=$install_root/bin/qq-relay

if [[ ! -x "$relay_bin" ]]; then
  printf 'qq-relay: installed executable is unavailable: %s (install qq-relay at the configured root)\n' "$relay_bin" >&2
  exit 69
fi
exec "$relay_bin" "$@"
