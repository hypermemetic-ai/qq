{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "qq observer verified intake result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "handoff_id", "mapping", "tasks", "verified_at"],
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z]+-[1-9][0-9]*(\\.[1-9][0-9]*)?$"
    }
  },
  "properties": {
    "schema": {"const": "qq-handoff/intake-result-v1"},
    "version": {"const": 1},
    "status": {"const": "done"},
    "handoff_id": {"type": "string", "pattern": "^handoff-[0-9a-f]{32}$"},
    "mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "task_ids"],
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/taskId"}
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id"],
        "properties": {"task_id": {"$ref": "#/$defs/taskId"}}
      }
    },
    "verified_at": {"type": "string"}
  }
}
