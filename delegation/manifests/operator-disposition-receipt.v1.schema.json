{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://qq.invalid/schemas/operator-disposition-receipt.v1.schema.json","title":"qq exact operator disposition receipt v1","type":"object","additionalProperties":false,"required":["version","receipt_id","change_id","exchange_id","trace_id","decision_id","decision_packet_id","outcome","operator_response","confirmation","captured_at"],"properties":{"version":{"const":1},"receipt_id":{"$ref":"#/$defs/id"},"change_id":{"$ref":"#/$defs/id"},"exchange_id":{"$ref":"#/$defs/id"},"trace_id":{"$ref":"#/$defs/traceId"},"decision_id":{"$ref":"#/$defs/id"},"decision_packet_id":{"$ref":"#/$defs/id"},"outcome":{"enum":["accepted","rejected","reshaped","opted-out"]},"operator_response":{"type":"string","minLength":1,"maxLength":16384},"confirmation":{"type":"string","enum":["accept","reject","reshape","opt-out"]},"captured_at":{"type":"string","format":"date-time"}},"$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"traceId":{"type":"string","pattern":"^[0-9a-f]{32}$"}},"allOf":[{"if":{"properties":{"outcome":{"const":"accepted"}}},"then":{"properties":{"confirmation":{"const":"accept"}}}},{"if":{"properties":{"outcome":{"const":"rejected"}}},"then":{"properties":{"confirmation":{"const":"reject"}}}},{"if":{"properties":{"outcome":{"const":"reshaped"}}},"then":{"properties":{"confirmation":{"const":"reshape"}}}},{"if":{"properties":{"outcome":{"const":"opted-out"}}},"then":{"properties":{"confirmation":{"const":"opt-out"}}}}]}
