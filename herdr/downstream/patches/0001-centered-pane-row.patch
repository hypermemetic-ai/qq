+fn is_horizontal_row(node: &Node) -> bool {
+    match node {
+        Node::Pane(_) => true,
+        Node::Split {
+            direction,
+            first,
+            second,
+            ..
+        } => {
+            *direction == Direction::Horizontal
+                && is_horizontal_row(first)
+                && is_horizontal_row(second)
+        }
+    }
+}
+
+fn balance_horizontal_node(node: &mut Node) {
+    if let Node::Split {
+        ratio,
+        first,
+        second,
+        ..
+    } = node
+    {
+        let first_count = count_panes(first);
+        let total = first_count + count_panes(second);
+        *ratio = first_count as f32 / total as f32;
+        balance_horizontal_node(first);
+        balance_horizontal_node(second);
+    }
+}
