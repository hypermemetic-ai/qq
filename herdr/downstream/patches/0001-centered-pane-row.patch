+fn centered_pane_area(main_area: Rect, preferred_pane_width: u16, pane_count: usize) -> Rect {
+    if preferred_pane_width == 0 || pane_count == 0 {
+        return main_area;
+    }
+
+    let desired_width = (preferred_pane_width as usize)
+        .saturating_mul(pane_count)
+        .min(main_area.width as usize) as u16;
+    Rect::new(
+        main_area.x + main_area.width.saturating_sub(desired_width) / 2,
+        main_area.y,
+        desired_width,
+        main_area.height,
+    )
+}
