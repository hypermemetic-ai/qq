{
  "schema": "qq.machine-migration",
  "schema_version": 1,
  "required_home": "/home/qqp",
  "versioned_roots": [
    {"path": "cockpit", "class": "git", "reason": "portable non-secret runtime and terminal configuration"},
    {"path": "machine", "class": "git", "reason": "package declarations, state boundary, and cutover procedure"},
    {"path": "bin/qq-machine-migrate", "class": "git", "reason": "capture, transfer, verification, and reconstruction logic"},
    {"path": "bin/qq-mint-pxe", "class": "git", "reason": "signed UEFI proxy-DHCP/TFTP/HTTP service lifecycle"}
  ],
  "repositories": [
    {"path": "projects/deciq", "remote": "git@github.com:hypermemetic-ai/deciq.git"},
    {"path": "projects/deciq-logic", "remote": "git@github.com:hypermemetic-ai/deciq-logic.git"},
    {"path": "projects/discuss", "remote": "git@github.com:qqp-dev/discuss.git"},
    {"path": "projects/everything-box", "remote": "git@github.com:qqp-dev/everything-box.git"},
    {"path": "projects/qq", "remote": "git@github.com:hypermemetic-ai/qq.git"},
    {"path": "projects/qq-dictation", "remote": "git@github.com:qqp-dev/qq-dictation.git"},
    {"path": "projects/rim", "remote": "git@github.com:hypermemetic-ai/rim.git"},
    {"path": "projects/rim-qq-evaluation", "remote": null},
    {"path": "projects/ytgrab", "remote": "git@github.com:qqp-dev/ytgrab.git"}
  ],
  "exact_roots": [
    {"path": "projects", "class": "source", "reason": "primary checkouts, Git metadata, ignored working assets, and the local-only evaluation Repository"},
    {"path": ".herdr", "class": "source", "reason": "Herdr-linked Git worktrees, including uncommitted working state"},
    {"path": ".local/share/qq", "class": "source", "reason": "Qq-linked worktrees and the exact patched Pi runtime"},
    {"path": ".local/state/qq", "class": "private", "reason": "Backlog store, run evidence, migration captures, and Qq mutable state"},
    {"path": ".pi", "class": "private", "reason": "all Pi sessions, auth, configuration, package lock/tree, histories, and browser artifacts"},
    {"path": ".pi-lens", "class": "private", "reason": "Pi diagnostics and session-adjacent state"},
    {"path": ".pi-subagents", "class": "private", "reason": "historical Pi session-adjacent state retained for resume fidelity"},
    {"path": ".codex", "class": "private", "reason": "all Codex sessions, archived sessions, auth, configuration, history, memories, goals, and indexes"},
    {"path": ".config/herdr", "class": "private", "reason": "live Herdr configuration and logs; sockets are excluded"},
    {"path": ".config/git", "class": "private", "reason": "global Git ignore state"},
    {"path": ".agent-browser", "class": "private", "reason": "Pi browser session profiles"},
    {"path": ".chrome-verification", "class": "private", "reason": "credentialed browser state used by project sessions"},
    {"path": ".config/google-chrome-for-testing", "class": "private", "reason": "browser runtime/profile state used by Pi extensions"},
    {"path": ".ssh", "class": "credential", "reason": "Git and host authentication; target authorized_keys is preserved"},
    {"path": ".gnupg", "class": "credential", "reason": "signing and verification identities"},
    {"path": ".config/gh", "class": "credential", "reason": "GitHub CLI authentication and configuration"},
    {"path": ".config/gcloud", "class": "credential", "reason": "Google Cloud project authentication and configuration"},
    {"path": ".aws", "class": "credential", "reason": "AWS project authentication and configuration"},
    {"path": ".azure", "class": "credential", "reason": "Azure project authentication and configuration"},
    {"path": ".openwiki", "class": "private", "reason": "Qq OpenWiki auth and local working state"},
    {"path": ".moonshot-key", "class": "credential", "reason": "Pi provider credential"},
    {"path": ".terraform.d", "class": "credential", "reason": "OpenTofu and Terraform user credentials and state"},
    {"path": ".homebrew", "class": "private", "reason": "Homebrew trust decisions"},
    {"path": ".local/share/pipx", "class": "derived", "reason": "exact pipx environments retained alongside pinned rebuild declarations"},
    {"path": ".local/share/fonts", "class": "derived", "reason": "operator fonts required by the versioned terminal cockpit"},
    {"path": ".gitconfig", "class": "private", "reason": "Git identity and preferences"},
    {"path": ".bashrc", "class": "private", "reason": "interactive tool paths and Qq shell mount"},
    {"path": ".bash_aliases", "class": "private", "reason": "operator shell aliases"},
    {"path": ".profile", "class": "private", "reason": "login shell environment"},
    {"path": "docs", "class": "private", "reason": "local project specifications"},
    {"path": "deciq-internal-testing", "class": "private", "reason": "local DecIQ test material"},
    {"path": "deciq-task55-preservation-2026-07-24", "class": "private", "reason": "uncommitted DecIQ preservation packet"},
    {"path": "deciq-verification-packet", "class": "private", "reason": "DecIQ verification project"},
    {"path": "perf-reports", "class": "private", "reason": "cross-project performance reports"},
    {"path": "voice-audition", "class": "private", "reason": "local voice project"},
    {"path": "display-panel-test.html", "class": "private", "reason": "local display test artifact"},
    {"path": "qq-cutover.sh", "class": "private", "reason": "historical Qq cutover procedure"},
    {"path": "qqac-flip.sh", "class": "private", "reason": "historical Qq activation procedure"},
    {"path": "google-cloud-sdk", "class": "derived", "reason": "user-local Google Cloud CLI installation paired with transferred auth"}
  ],
  "session_roots": [
    ".pi/agent/sessions",
    ".codex/sessions",
    ".codex/archived_sessions"
  ],
  "config_links": [
    {"source": "cockpit/ghostty/config", "target": ".config/ghostty/config"},
    {"source": "cockpit/ghostty/shaders/column-rails.glsl", "target": ".config/ghostty/shaders/column-rails.glsl"},
    {"source": "cockpit/glow/glow.yml", "target": ".config/glow/glow.yml"},
    {"source": "cockpit/herdr/config.toml", "target": ".config/herdr/config.toml"},
    {"source": "cockpit/pi/settings.json", "target": ".pi/agent/settings.json"},
    {"source": "cockpit/pi/keybindings.json", "target": ".pi/agent/keybindings.json"},
    {"source": "cockpit/pi/sandbox.json", "target": ".pi/agent/sandbox.json"},
    {"source": "cockpit/pi/trust.json", "target": ".pi/agent/trust.json"},
    {"source": "cockpit/codex/config.toml", "target": ".codex/config.toml"},
    {"source": "cockpit/git/ignore", "target": ".config/git/ignore"},
    {"source": "cockpit/homebrew/trust.json", "target": ".homebrew/trust.json"},
    {"source": "cockpit/shell/aliases.bash", "target": ".bash_aliases"}
  ],
  "rsync_excludes": [
    ".config/herdr/*.sock",
    ".config/herdr/*.sock.lock",
    ".ssh/authorized_keys"
  ]
}
